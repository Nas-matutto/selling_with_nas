{
	"version": 3,
	"routes": [
		{
			"src": "^/(.*)/$",
			"headers": {
				"Location": "/$1"
			},
			"status": 308
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)$",
			"dest": "_render"
		},
		{
			"src": "^/_image$",
			"dest": "_render"
		},
		{
			"src": "^/404$",
			"dest": "_render"
		},
		{
			"src": "^/ai-masterclass-with-nas$",
			"dest": "_render"
		},
		{
			"src": "^/api/analyze-product$",
			"dest": "_render"
		},
		{
			"src": "^/api/send-guide$",
			"dest": "_render"
		},
		{
			"src": "^/contact$",
			"dest": "_render"
		},
		{
			"src": "^/rss\\.xml/?$",
			"dest": "_render"
		},
		{
			"src": "^/tools/E-commerce_calculator$",
			"dest": "_render"
		},
		{
			"src": "^/tools/launch-cost-estimator$",
			"dest": "_render"
		},
		{
			"src": "^/tools/leadlanding$",
			"dest": "_render"
		},
		{
			"src": "^/tools/quizzings$",
			"dest": "_render"
		},
		{
			"src": "^/tools/talk-to-me-data$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}