PUBLIC_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID_HERE/exec

# ── Meta Conversions API (src/pages/api/cal-webhook.ts) ──
# Reports Cal.com bookings to Meta server-side so campaigns can optimise for
# booked meetings. Both of these are secrets - never commit real values.

# Events Manager > Data Sources > your pixel > Settings > Conversions API >
# "Generate access token"
META_CAPI_ACCESS_TOKEN=

# The secret you set when creating the webhook in Cal.com (Settings > Developer >
# Webhooks). Used to verify the request genuinely came from Cal.com.
CAL_WEBHOOK_SECRET=

# Optional - defaults to the live-session pixel (1700269051050500).
META_PIXEL_ID=1700269051050500

# Optional - set while testing to route events to Events Manager > Test Events.
# Remove it once you go live, or real conversions will only appear in test view.
META_TEST_EVENT_CODE=

# Optional - defaults to v21.0.
META_API_VERSION=
