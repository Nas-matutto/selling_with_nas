---
import '~/assets/styles/tailwind.css';

import { I18N } from 'astrowind:config';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';
import MetaPixel from '~/components/common/MetaPixel.astro';

import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
  /** Meta (Facebook) Pixel ID. Pass one to enable the pixel on this page only. */
  metaPixelId?: string;
}

const { metadata = {}, metaPixelId } = Astro.props;
const { language, textDirection } = I18N;
---

<!doctype html>
<html lang={language} dir={textDirection} class="2xl:text-[20px]">
  <head>
    <CommonMeta />
    <Favicons />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    <SiteVerification />
    
    <!-- Google Analytics - deferred so the ~485KB gtag.js never competes with
         page content on slow mobile connections. It loads after the page is
         interactive, or on the first user interaction (whichever comes first). -->
    <script is:inline define:vars={{ gaId: 'G-N49NK79QS7' }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', gaId, { transport_type: 'beacon' });

      let gaLoaded = false;
      function loadGA() {
        if (gaLoaded) return;
        gaLoaded = true;
        const s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
        document.head.appendChild(s);
      }

      // Whichever fires first: 3s after full load, or the first real interaction.
      window.addEventListener('load', () => setTimeout(loadGA, 3000), { once: true });
      ['scroll', 'pointerdown', 'keydown', 'touchstart'].forEach((evt) =>
        window.addEventListener(evt, loadGA, { once: true, passive: true })
      );
    </script>

    {metaPixelId && <MetaPixel id={metaPixelId} />}
  </head>

  <body class="antialiased text-default bg-page tracking-tight">
    {
      /* Meta's no-JS fallback. Lives at the top of <body> rather than in <head>,
         where the HTML spec doesn't allow <img> inside <noscript>. */
      metaPixelId && (
        <noscript>
          <img
            height="1"
            width="1"
            style="display:none"
            alt=""
            src={`https://www.facebook.com/tr?id=${metaPixelId}&ev=PageView&noscript=1`}
          />
        </noscript>
      )
    }
    <slot />

    <BasicScripts />
  </body>
</html>
