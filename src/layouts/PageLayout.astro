---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import { headerData } from '~/navigation';
import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
}

const { metadata } = Astro.props;
const isMasterclassPage = Astro.url.pathname.includes('ai-masterclass-with-nas');
---

<Layout metadata={metadata}>
  <slot name="header">
    <Header
      links={headerData.links}
      actions={headerData.actions}
      isSticky
      showToggleTheme
    />
  </slot>

  <main>
    <slot />
  </main>

  <!-- ── CUSTOM FOOTER ── -->
  <footer id="site-footer">
    <div id="site-footer-inner">
      <div id="site-footer-top">

        <!-- Brand column -->
        <div id="site-footer-brand">
          <a href="/" id="site-footer-logo">Selling with Nas</a>
          <p id="site-footer-tagline">Helping founders and brands move faster with AI, automation, and GTM strategy that ships.</p>
          <div id="site-footer-socials">
            <a href="https://www.youtube.com/@sellingwithnas" target="_blank" rel="noopener noreferrer" class="site-footer-social" aria-label="YouTube">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </a>
            <a href="https://www.linkedin.com/in/nasser-mansurali-659145102/" target="_blank" rel="noopener noreferrer" class="site-footer-social" aria-label="LinkedIn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
            <a href="https://www.tiktok.com/@sellingwithnas" target="_blank" rel="noopener noreferrer" class="site-footer-social" aria-label="TikTok">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.76a4.85 4.85 0 0 1-1.01-.07z"/></svg>
            </a>
            <a href="https://www.instagram.com/sellingwithnas/" target="_blank" rel="noopener noreferrer" class="site-footer-social" aria-label="Instagram">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
            </a>
          </div>
        </div>

        <!-- Content column -->
        <div class="site-footer-col">
          <h3 class="site-footer-col-title">Content</h3>
          <ul class="site-footer-links">
            <li><a href="/blog">Blog Posts</a></li>
            <li><a href="/guides">Guides</a></li>
          </ul>
        </div>

        <!-- Work with Me column -->
        <div class="site-footer-col">
          <h3 class="site-footer-col-title">Work with Me</h3>
          <ul class="site-footer-links">
            <li><a href="/#hp-services">Services</a></li>
            <li><a href="/ai-masterclass-with-nas">AI Masterclass</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>

        <!-- Products column -->
        <div class="site-footer-col">
          <h3 class="site-footer-col-title">Products</h3>
          <ul class="site-footer-links">
            <li><a href="/tools/talk-to-me-data">Talk to Me Data</a></li>
            <li><a href="/tools/leadlanding">LeadLanding</a></li>
          </ul>
        </div>

      </div>

      <div id="site-footer-bottom">
        <span>© 2026 Selling with Nas. All rights reserved.</span>
      </div>
    </div>
  </footer>

  <!-- ── POPUP ── -->
  {!isMasterclassPage && (
    <div id="mc-popup" role="dialog" aria-modal="true" aria-label="AI Masterclass popup" style="display:none;">
      <div id="mc-popup-backdrop"></div>
      <div id="mc-popup-card">
        <button id="mc-popup-close" aria-label="Close">&times;</button>
        <div id="mc-popup-icon">🎓</div>
        <p id="mc-popup-eyebrow">Live session</p>
        <h2 id="mc-popup-title">Join my AI Masterclass later this month</h2>
        <p id="mc-popup-body">Learn how to build real AI Agents and automation workflows in a live session with me.</p>
        <div id="mc-popup-actions">
          <a href="/ai-masterclass-with-nas" id="mc-popup-cta">Learn more →</a>
          <button id="mc-popup-dismiss">Not interested</button>
        </div>
      </div>
    </div>
  )}
</Layout>

<style is:global>
  /* ══════════════════════════════════
     FOOTER
  ══════════════════════════════════ */
  #site-footer {
    background: #f8fafc;
    border-top: 1px solid #e2e8f0;
    color: #0f172a;
    font-family: inherit;
  }
  .dark #site-footer {
    background: #0a0a14;
    border-top-color: rgba(255,255,255,0.08);
    color: #e2e8f0;
  }
  #site-footer-inner {
    max-width: 1140px;
    margin: 0 auto;
    padding: 56px 24px 32px;
  }
  #site-footer-top {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 48px;
    padding-bottom: 40px;
    border-bottom: 1px solid #e2e8f0;
  }
  .dark #site-footer-top {
    border-bottom-color: rgba(255,255,255,0.07);
  }
  #site-footer-logo {
    font-size: 1.1rem;
    font-weight: 800;
    color: #0f172a;
    text-decoration: none;
    display: block;
    margin-bottom: 12px;
    letter-spacing: -0.02em;
  }
  .dark #site-footer-logo { color: #f8fafc; }
  #site-footer-tagline {
    font-size: 0.875rem;
    color: #64748b;
    line-height: 1.6;
    margin: 0 0 20px 0;
    max-width: 280px;
  }
  .dark #site-footer-tagline { color: #64748b; }
  #site-footer-socials {
    display: flex;
    gap: 10px;
  }
  .site-footer-social {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: #e2e8f0;
    color: #475569;
    text-decoration: none;
    transition: background 0.18s ease, color 0.18s ease;
  }
  .dark .site-footer-social {
    background: rgba(255,255,255,0.07);
    color: #94a3b8;
  }
  .site-footer-social:hover {
    background: #f97316;
    color: #fff;
  }
  .site-footer-col-title {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #94a3b8;
    margin: 0 0 16px 0;
  }
  .site-footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .site-footer-links a {
    font-size: 0.9rem;
    color: #475569;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .dark .site-footer-links a { color: #94a3b8; }
  .site-footer-links a:hover { color: #f97316; }
  #site-footer-bottom {
    padding-top: 28px;
    font-size: 0.82rem;
    color: #94a3b8;
  }

  @media (max-width: 900px) {
    #site-footer-top {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
    #site-footer-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 540px) {
    #site-footer-top {
      grid-template-columns: 1fr;
    }
    #site-footer-brand {
      grid-column: auto;
    }
  }

  /* ══════════════════════════════════
     POPUP
  ══════════════════════════════════ */
  #mc-popup {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  #mc-popup-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(4px);
  }
  #mc-popup-card {
    position: relative;
    z-index: 1;
    background: #ffffff;
    border-radius: 20px;
    padding: 40px 36px 32px;
    max-width: 420px;
    width: 100%;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.2);
    text-align: center;
  }
  .dark #mc-popup-card {
    background: #0f1120;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  #mc-popup-close {
    position: absolute; top: 14px; right: 16px;
    background: none; border: none;
    font-size: 1.4rem; line-height: 1;
    color: #94a3b8; cursor: pointer;
    padding: 4px 8px; border-radius: 6px;
    transition: color 0.15s, background 0.15s;
  }
  #mc-popup-close:hover { color: #0f172a; background: #f1f5f9; }
  .dark #mc-popup-close:hover { color: #f8fafc; background: rgba(255,255,255,0.08); }
  #mc-popup-icon { font-size: 2.4rem; margin-bottom: 12px; }
  #mc-popup-eyebrow {
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em;
    text-transform: uppercase; color: #a855f7; margin: 0 0 10px;
  }
  #mc-popup-title {
    font-size: 1.25rem; font-weight: 800; color: #0f172a;
    margin: 0 0 12px; letter-spacing: -0.02em; line-height: 1.25;
  }
  .dark #mc-popup-title { color: #f8fafc; }
  #mc-popup-body {
    font-size: 0.9rem; color: #64748b; line-height: 1.65; margin: 0 0 28px;
  }
  .dark #mc-popup-body { color: #94a3b8; }
  #mc-popup-actions { display: flex; flex-direction: column; gap: 10px; }
  #mc-popup-cta {
    display: block; padding: 13px 24px; border-radius: 12px;
    font-size: 0.95rem; font-weight: 700; text-decoration: none;
    background: linear-gradient(135deg, #f97316, #a855f7); color: #fff;
    box-shadow: 0 4px 20px rgba(168,85,247,0.3);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  #mc-popup-cta:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(168,85,247,0.4); }
  #mc-popup-dismiss {
    display: block; width: 100%; padding: 11px 24px; border-radius: 12px;
    font-size: 0.88rem; font-weight: 600; background: none;
    border: 1px solid #e2e8f0; color: #64748b; cursor: pointer;
    transition: all 0.2s ease;
  }
  .dark #mc-popup-dismiss { border-color: rgba(255,255,255,0.1); }
  #mc-popup-dismiss:hover { background: #f8fafc; color: #0f172a; border-color: #94a3b8; }
  .dark #mc-popup-dismiss:hover { background: rgba(255,255,255,0.06); color: #e2e8f0; }
  @media (max-width: 480px) {
    #mc-popup-card { padding: 32px 24px 28px; }
  }
</style>

<script>
  const STORAGE_KEY = 'nas_mc_popup_seen';
  const popup = document.getElementById('mc-popup');

  function closePopup() {
    if (popup) {
      popup.style.opacity = '0';
      popup.style.transition = 'opacity 0.25s ease';
      setTimeout(() => { (popup as HTMLElement).style.display = 'none'; }, 250);
    }
    sessionStorage.setItem(STORAGE_KEY, '1');
  }

  if (popup && !sessionStorage.getItem(STORAGE_KEY)) {
    setTimeout(() => { (popup as HTMLElement).style.display = 'flex'; }, 10000);
  }

  document.getElementById('mc-popup-dismiss')?.addEventListener('click', closePopup);
  document.getElementById('mc-popup-close')?.addEventListener('click', closePopup);
  document.getElementById('mc-popup-backdrop')?.addEventListener('click', closePopup);
  document.getElementById('mc-popup-cta')?.addEventListener('click', () => {
    sessionStorage.setItem(STORAGE_KEY, '1');
  });
</script>
