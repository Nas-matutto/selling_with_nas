---
// Lightweight YouTube "facade": shows the thumbnail + a play button and only
// loads the real (heavy) YouTube iframe when the user clicks. This keeps ~850 KiB
// of YouTube player JS/CSS and its cookies off the initial page load.
//
// Drop it inside any wrapper that already sizes/styles a child <iframe> to fill
// it (e.g. .hp-yt-video-wrap, .ls-video) - the injected iframe inherits that CSS.
//
// `autoplay` swaps the iframe in on its own, muted (browsers block unmuted
// autoplay), but only after the page has loaded and the video is near the
// viewport - so the player JS still never competes with the page's first paint.
interface Props {
  id: string;
  title?: string;
  class?: string;
  autoplay?: boolean;
}
const { id, title = 'YouTube video', class: className, autoplay = false } = Astro.props;
// mqdefault is 16:9 (no letterbox bars) and always exists for every video.
const thumb = `https://i.ytimg.com/vi/${id}/mqdefault.jpg`;
---

<button
  type="button"
  class:list={['yt-lite', className]}
  data-ytid={id}
  data-title={title}
  data-autoplay={autoplay ? '' : undefined}
  aria-label={`Play video: ${title}`}
>
  <img class="yt-lite-thumb" src={thumb} alt="" loading="lazy" decoding="async" width="320" height="180" />
  <span class="yt-lite-play" aria-hidden="true">
    <svg viewBox="0 0 68 48" width="68" height="48" focusable="false">
      <path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.64 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="#f00"></path>
      <path d="M45 24 27 14v20z" fill="#fff"></path>
    </svg>
  </span>
</button>

<style is:global>
  .yt-lite {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    border: 0;
    display: block;
    cursor: pointer;
    background: #000;
    overflow: hidden;
  }
  .yt-lite-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.2s ease;
  }
  .yt-lite:hover .yt-lite-thumb { opacity: 0.85; }
  .yt-lite-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.4));
    transition: transform 0.2s ease;
  }
  .yt-lite:hover .yt-lite-play { transform: translate(-50%, -50%) scale(1.08); }
  .yt-lite-play svg { width: 68px; height: 48px; }
</style>

<script>
  // Replace a facade with the real player. `muted` is for autoplay without a
  // click - a click counts as user intent, so that path keeps its sound.
  const load = (btn: HTMLElement, muted: boolean) => {
    const id = btn.dataset.ytid;
    if (!id || !btn.isConnected) return;
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&playsinline=1${muted ? '&mute=1' : ''}`;
    iframe.title = btn.dataset.title || 'YouTube video';
    iframe.allow =
      'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    iframe.setAttribute('allowfullscreen', '');
    // The parent wrapper already styles its child <iframe> to fill it.
    btn.replaceWith(iframe);
    if (!muted) iframe.focus();
  };

  // One delegated listener handles every facade on the page (and, because it
  // lives on `document`, keeps working across Astro view-transition navigations).
  if (!(window as any).__ytLiteBound) {
    (window as any).__ytLiteBound = true;
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('.yt-lite');
      if (btn) load(btn, false);
    });
  }

  const autoplayers = document.querySelectorAll<HTMLElement>('.yt-lite[data-autoplay]');
  if (autoplayers.length) {
    const start = () => {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            io.unobserve(e.target);
            load(e.target as HTMLElement, true);
          });
        },
        { rootMargin: '200px 0px' }
      );
      autoplayers.forEach((el) => io.observe(el));
    };
    if (document.readyState === 'complete') start();
    else window.addEventListener('load', start, { once: true });
  }
</script>
