---
import Layout from '~/layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import quizzingsImage from '~/assets/images/Customer_reviews_quizzings.png';

const metadata = {
  title: 'Quizzings - Collect & Embed Customer Reviews | Selling with Nas',
  description: 'Quizzings helps startups and small businesses collect verified customer reviews and embed them on their site with one line of code — no dev team required.',
  keywords: 'Quizzings, customer reviews, review collection, embed reviews, testimonials widget, social proof, review platform for startups, Trustpilot alternative',
  canonical: 'https://www.sellingwithnas.com/tools/quizzings',
};
---

<Layout metadata={metadata}>
  <div class="product-page">
    <div class="floating-elements">
      <div class="floating-circle"></div>
      <div class="floating-circle"></div>
      <div class="floating-circle"></div>
    </div>

    <div class="container">

      <!-- Hero Section -->
      <div class="hero-section">
        <div class="hero-text">
          <div class="badge">Product</div>
          <h1>Quizzings</h1>
          <p class="hero-subtitle">Collect verified customer reviews and embed them on your site in minutes. Built for startups and small business owners who need social proof without the cost or complexity of a bloated review platform.</p>
          <div class="hero-actions">
            <a href="https://quizzings.com/" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Start Free Trial →</a>
            <a href="https://quizzings.com/" target="_blank" rel="noopener noreferrer" class="btn btn-outline">See Pricing</a>
          </div>
          <p class="hero-note">7-day free trial · No credit card required · Live in ~5 minutes</p>
        </div>
        <div class="hero-image">
          <Image src={quizzingsImage} alt="Quizzings - Collect and embed customer reviews" class="product-screenshot" width={700} />
        </div>
      </div>

      <!-- Why Quizzings Section -->
      <div class="info-section">
        <h2 class="section-title"><b>Why Quizzings?</b></h2>
        <p class="section-intro">Trustpilot and G2 are built for enterprise budgets and week-long setups. Quizzings gets you a review collection link, a moderation queue, and a widget on your own domain — usually before your coffee gets cold.</p>

        <div class="stat-row">
          <div class="stat-card">
            <div class="stat-number">~5 min</div>
            <div class="stat-label">To go live on your site</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">1 line</div>
            <div class="stat-label">Of code to embed reviews</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">$19/mo</div>
            <div class="stat-label">Pro plan, up to 250 reviews</div>
          </div>
        </div>
      </div>

      <!-- Features Section -->
      <div class="info-section">
        <h2 class="section-title"><b>Key Features</b></h2>

        <div class="feature-item">
          <div class="feature-icon">🔗</div>
          <div>
            <h3>Frictionless Review Collection</h3>
            <p>Send customers a simple link — no account creation, no app download. They leave a review in seconds, and it lands straight in your dashboard.</p>
          </div>
        </div>

        <div class="feature-item">
          <div class="feature-icon">🧩</div>
          <div>
            <h3>One-Line Embed, Your Domain</h3>
            <p>Paste a single snippet and reviews show up on your site instantly. Choose from grid, list, or badge layouts. Reviews live on your own domain with Schema.org markup baked in for SEO.</p>
          </div>
        </div>

        <div class="feature-item">
          <div class="feature-icon">🛡️</div>
          <div>
            <h3>Moderation Queue</h3>
            <p>Every submission passes through a review queue first. Hide anything irrelevant or inappropriate without deleting it — you stay in control of what goes public.</p>
          </div>
        </div>

        <div class="feature-item">
          <div class="feature-icon">🧠</div>
          <div>
            <h3>AI Theme Extraction</h3>
            <p>Quizzings automatically surfaces the topics customers mention most — pricing, support, a specific feature — so you spot patterns without reading every single review.</p>
          </div>
        </div>

        <div class="feature-item">
          <div class="feature-icon">📥</div>
          <div>
            <h3>CSV Import</h3>
            <p>Already have reviews sitting in a spreadsheet or another tool? Import them in bulk and skip starting from zero.</p>
          </div>
        </div>

        <div class="feature-item">
          <div class="feature-icon">📬</div>
          <div>
            <h3>Weekly Digest</h3>
            <p>Get a summary email of new reviews and emerging themes, so you stay on top of what customers are saying without logging into a dashboard every day.</p>
          </div>
        </div>
      </div>

      <!-- How It Works Section -->
      <div class="info-section">
        <h2 class="section-title"><b>How It Works</b></h2>

        <div class="steps-grid">
          <div class="step-card">
            <div class="step-number">1</div>
            <h3>Share the Link</h3>
            <p>Send customers a review link by email, text, or after checkout. No login required on their end.</p>
          </div>
          <div class="step-card">
            <div class="step-number">2</div>
            <h3>Moderate Submissions</h3>
            <p>New reviews land in a queue. Approve or hide them with one click before they go live.</p>
          </div>
          <div class="step-card">
            <div class="step-number">3</div>
            <h3>Embed With One Line</h3>
            <p>Paste a snippet on your site and choose a layout. Your reviews, on your domain, styled to match.</p>
          </div>
          <div class="step-card">
            <div class="step-number">4</div>
            <h3>Track What Matters</h3>
            <p>AI-surfaced themes and a weekly digest keep you current on customer sentiment without extra work.</p>
          </div>
        </div>
      </div>

      <!-- Who It's For Section -->
      <div class="info-section">
        <h2 class="section-title"><b>Who It's For</b></h2>
        <div class="use-case-grid">
          <div class="use-case-card">
            <div class="use-case-icon">🚀</div>
            <h3>Early-Stage Startups</h3>
            <p>Build social proof from day one without committing to an enterprise review platform or a lengthy setup.</p>
          </div>
          <div class="use-case-card">
            <div class="use-case-icon">🏪</div>
            <h3>Small Business Owners</h3>
            <p>No developer on staff? One line of code is all it takes to show real customer feedback on your site.</p>
          </div>
          <div class="use-case-card">
            <div class="use-case-icon">💻</div>
            <h3>SaaS Founders</h3>
            <p>Turn happy users into a credibility widget on your landing page — the kind of proof that moves trial signups.</p>
          </div>
          <div class="use-case-card">
            <div class="use-case-icon">🛍️</div>
            <h3>E-Commerce Brands</h3>
            <p>Show verified reviews on product pages without paying for a subscription review platform you'll outgrow.</p>
          </div>
        </div>
      </div>

      <!-- CTA Section -->
      <div class="cta-section">
        <h2>Start Collecting Reviews That Convert</h2>
        <p>Get your review link live and embedded on your site in about five minutes.</p>
        <a href="https://quizzings.com/" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Try Quizzings Free →</a>
      </div>

      <!-- Back button -->
      <div style="text-align: center; margin: 40px 0;">
        <a href="/" class="btn btn-secondary">← Back to Home</a>
      </div>

    </div>
  </div>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Quizzings",
    "description": "Review collection platform for startups and small businesses — collect verified customer reviews and embed them on your site with one line of code.",
    "url": "https://quizzings.com/",
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "Web Browser",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD",
      "description": "7-day free trial, up to 10 reviews, no credit card required"
    },
    "featureList": [
      "Frictionless review collection via link",
      "One-line embed with multiple layouts",
      "Moderation queue",
      "AI-powered theme extraction",
      "CSV import of existing reviews",
      "Weekly digest emails",
      "Schema.org markup for SEO"
    ],
    "creator": {
      "@type": "Person",
      "name": "Nas",
      "url": "https://www.sellingwithnas.com"
    }
  }
  </script>
</Layout>

<style>
  .product-page {
    background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 40%, #fed7aa 100%);
    min-height: 100vh;
    color: #0f172a;
    overflow-x: hidden;
    padding-top: 80px;
  }

  .product-page * {
    box-sizing: border-box;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
  }

  /* Hero */
  .hero-section {
    display: flex;
    align-items: center;
    gap: 48px;
    margin-bottom: 50px;
    padding: 20px 0;
  }

  .hero-text {
    flex: 1.1;
    text-align: left;
  }

  .hero-image {
    flex: 0.9;
    max-width: 380px;
  }

  .badge {
    display: inline-block;
    background: linear-gradient(135deg, #f97316, #ef4444);
    color: white;
    padding: 6px 20px;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    margin-bottom: 20px;
    text-transform: uppercase;
  }

  .hero-section h1 {
    font-size: 3rem;
    font-weight: 700;
    background: linear-gradient(45deg, #f97316, #ef4444, #a855f7);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradientShift 3s ease-in-out infinite;
    margin: 0 0 20px 0;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: #475569;
    margin: 0 0 28px 0;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .hero-note {
    font-size: 0.85rem;
    color: #94a3b8;
    margin: 0;
  }

  .product-screenshot {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 16px;
    border: 2px solid rgba(249, 115, 22, 0.3);
    box-shadow: 0 20px 40px rgba(249, 115, 22, 0.15);
    transition: all 0.3s ease;
  }

  .product-screenshot:hover {
    border-color: rgba(249, 115, 22, 0.6);
    box-shadow: 0 25px 50px rgba(249, 115, 22, 0.25);
  }

  @keyframes gradientShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  /* Sections */
  .info-section {
    background: rgba(255, 255, 255, 0.9);
    border-radius: 20px;
    padding: 36px 30px;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(249, 115, 22, 0.2);
    box-shadow: 0 20px 40px rgba(249, 115, 22, 0.1);
    transition: all 0.3s ease;
    margin-bottom: 30px;
  }

  .info-section:hover {
    transform: translateY(-4px);
    box-shadow: 0 25px 50px rgba(249, 115, 22, 0.15);
  }

  .section-title {
    font-size: 1.8rem;
    margin-bottom: 10px;
    color: #f97316;
    text-align: center;
    position: relative;
    padding-bottom: 18px;
  }

  .section-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 3px;
    background: linear-gradient(90deg, #f97316, #ef4444);
    border-radius: 2px;
  }

  .section-intro {
    text-align: center;
    color: #475569;
    font-size: 1.05rem;
    max-width: 720px;
    margin: 16px auto 28px auto;
    line-height: 1.7;
  }

  /* Stats Row */
  .stat-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 10px;
  }

  .stat-card {
    text-align: center;
    padding: 24px 16px;
    background: linear-gradient(135deg, rgba(249,115,22,0.06), rgba(239,68,68,0.06));
    border-radius: 16px;
    border: 1px solid rgba(249,115,22,0.15);
  }

  .stat-number {
    font-size: 2.2rem;
    font-weight: 800;
    background: linear-gradient(135deg, #f97316, #ef4444);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 6px;
  }

  .stat-label {
    font-size: 0.9rem;
    color: #64748b;
    font-weight: 500;
  }

  /* Feature Items */
  .feature-item {
    display: flex;
    gap: 18px;
    padding: 22px;
    margin-bottom: 14px;
    background: rgba(255, 255, 255, 0.6);
    border-radius: 14px;
    border: 1px solid rgba(249, 115, 22, 0.1);
    transition: all 0.3s ease;
  }

  .feature-item:last-child {
    margin-bottom: 0;
  }

  .feature-item:hover {
    background: rgba(255, 255, 255, 0.95);
    transform: translateX(4px);
    border-color: rgba(249, 115, 22, 0.25);
  }

  .feature-icon {
    font-size: 1.8rem;
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feature-item h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 6px 0;
  }

  .feature-item p {
    font-size: 0.95rem;
    color: #475569;
    margin: 0;
    line-height: 1.6;
  }

  /* Steps Grid */
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 20px;
  }

  .step-card {
    padding: 24px;
    background: rgba(255,255,255,0.6);
    border-radius: 16px;
    border: 1px solid rgba(249,115,22,0.12);
    transition: all 0.3s ease;
    position: relative;
  }

  .step-card:hover {
    background: rgba(255,255,255,0.95);
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(249,115,22,0.1);
  }

  .step-number {
    width: 36px;
    height: 36px;
    background: linear-gradient(135deg, #f97316, #ef4444);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: 14px;
  }

  .step-card h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 8px 0;
  }

  .step-card p {
    font-size: 0.92rem;
    color: #475569;
    margin: 0;
    line-height: 1.6;
  }

  /* Use Case Grid */
  .use-case-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 20px;
  }

  .use-case-card {
    padding: 24px;
    background: rgba(255,255,255,0.6);
    border-radius: 16px;
    border: 1px solid rgba(249,115,22,0.12);
    transition: all 0.3s ease;
  }

  .use-case-card:hover {
    background: rgba(255,255,255,0.95);
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(249,115,22,0.1);
  }

  .use-case-icon {
    font-size: 2rem;
    margin-bottom: 12px;
  }

  .use-case-card h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 8px 0;
  }

  .use-case-card p {
    font-size: 0.92rem;
    color: #475569;
    margin: 0;
    line-height: 1.6;
  }

  /* CTA Section */
  .cta-section {
    text-align: center;
    padding: 56px 30px;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 20px;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(249, 115, 22, 0.2);
    box-shadow: 0 20px 40px rgba(249, 115, 22, 0.1);
    margin-bottom: 20px;
  }

  .cta-section h2 {
    font-size: 2.2rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 14px 0;
  }

  .cta-section p {
    color: #475569;
    font-size: 1.1rem;
    margin: 0 0 28px 0;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Buttons */
  .btn {
    display: inline-block;
    padding: 12px 24px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 600;
    text-align: center;
    transition: all 0.3s ease;
  }

  .btn-primary {
    background: linear-gradient(135deg, #f97316, #ef4444);
    color: white;
    padding: 14px 36px;
    font-size: 1.05rem;
    box-shadow: 0 8px 25px rgba(249, 115, 22, 0.3);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 35px rgba(249, 115, 22, 0.45);
  }

  .btn-outline {
    background: transparent;
    color: #f97316;
    border: 2px solid #f97316;
    padding: 12px 28px;
    font-size: 1.05rem;
  }

  .btn-outline:hover {
    background: rgba(249, 115, 22, 0.08);
    transform: translateY(-2px);
  }

  .btn-secondary {
    background: transparent;
    color: #f97316;
    border: 2px solid #f97316;
  }

  .btn-secondary:hover {
    background: #f97316;
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(249, 115, 22, 0.4);
  }

  /* Floating Elements */
  .floating-elements {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: -1;
  }

  .floating-circle {
    position: absolute;
    border-radius: 50%;
    background: linear-gradient(45deg, rgba(249, 115, 22, 0.1), rgba(239, 68, 68, 0.1));
    animation: float 6s ease-in-out infinite;
  }

  .floating-circle:nth-child(1) {
    width: 80px;
    height: 80px;
    top: 20%;
    left: 10%;
    animation-delay: 0s;
  }

  .floating-circle:nth-child(2) {
    width: 120px;
    height: 120px;
    top: 60%;
    right: 15%;
    animation-delay: 2s;
  }

  .floating-circle:nth-child(3) {
    width: 60px;
    height: 60px;
    bottom: 20%;
    left: 20%;
    animation-delay: 4s;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(180deg); }
  }

  /* Responsive */
  @media (max-width: 900px) {
    .hero-section {
      flex-direction: column;
      text-align: center;
    }

    .hero-text {
      text-align: center;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-image {
      max-width: 320px;
    }
  }

  @media (max-width: 768px) {
    .hero-section h1 {
      font-size: 2.4rem;
    }

    .hero-subtitle {
      font-size: 1.05rem;
    }

    .container {
      padding: 15px;
    }

    .stat-row {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .steps-grid,
    .use-case-grid {
      grid-template-columns: 1fr;
    }

    .info-section {
      padding: 24px 18px;
    }
  }

  /* Dark Mode */
  :global(.dark) .product-page {
    background: linear-gradient(135deg, #0f0f23 0%, #1a1a2e 50%, #16213e 100%);
    color: #ffffff;
  }

  :global(.dark) .hero-subtitle {
    color: #a0a0a0;
  }

  :global(.dark) .hero-section h1 {
    background: linear-gradient(45deg, #fb923c, #ef4444, #a855f7);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: none;
  }

  :global(.dark) .product-screenshot {
    border-color: rgba(249, 115, 22, 0.3);
  }

  :global(.dark) .product-screenshot:hover {
    border-color: rgba(249, 115, 22, 0.6);
  }

  :global(.dark) .info-section,
  :global(.dark) .cta-section {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
  }

  :global(.dark) .section-title {
    color: #fb923c;
  }

  :global(.dark) .section-intro {
    color: #a0a0a0;
  }

  :global(.dark) .stat-card {
    background: linear-gradient(135deg, rgba(249,115,22,0.08), rgba(239,68,68,0.08));
    border-color: rgba(249,115,22,0.2);
  }

  :global(.dark) .stat-label {
    color: #94a3b8;
  }

  :global(.dark) .feature-item,
  :global(.dark) .step-card,
  :global(.dark) .use-case-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
  }

  :global(.dark) .feature-item:hover,
  :global(.dark) .step-card:hover,
  :global(.dark) .use-case-card:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  :global(.dark) .feature-item h3,
  :global(.dark) .step-card h3,
  :global(.dark) .use-case-card h3 {
    color: #e0e0e0;
  }

  :global(.dark) .feature-item p,
  :global(.dark) .step-card p,
  :global(.dark) .use-case-card p {
    color: #a0a0a0;
  }

  :global(.dark) .cta-section h2 {
    color: #e0e0e0;
  }

  :global(.dark) .cta-section p {
    color: #a0a0a0;
  }

  :global(.dark) .hero-note {
    color: #64748b;
  }

  :global(.dark) .btn-outline {
    color: #fb923c;
    border-color: #fb923c;
  }

  :global(.dark) .btn-outline:hover {
    background: rgba(251, 146, 60, 0.1);
  }

  :global(.dark) .btn-secondary {
    color: #fb923c;
    border-color: #fb923c;
  }

  :global(.dark) .btn-secondary:hover {
    background: #fb923c;
    color: #0f0f23;
  }

  :global(.dark) .btn-primary {
    background: linear-gradient(135deg, #fb923c, #ef4444);
  }
</style>
