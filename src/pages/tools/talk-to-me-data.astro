---
import Layout from '~/layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import ttmdImage from '~/assets/images/TTMD_HP.png';

const metadata = {
  title: 'Talk to Me Data - AI-Powered Landing Page Analytics | Selling with Nas',
  description: 'Talk to Me Data analyzes your landing page and gives you actionable insights to improve conversions, design, and user experience — powered by AI.',
  keywords: 'landing page analytics, AI website analysis, conversion optimization, Talk to Me Data, landing page feedback, website audit tool',
  canonical: 'https://www.sellingwithnas.com/tools/talk-to-me-data',
};
---

<Layout metadata={metadata}>
  <div class="product-page">
    <div class="floating-elements">
      <div class="floating-circle"></div>
      <div class="floating-circle"></div>
      <div class="floating-circle"></div>
    </div>

    <div class="container">
      <!-- Hero Section -->
      <div class="hero-section">
        <div class="badge">Product</div>
        <h1>Talk to Me Data</h1>
        <p class="hero-subtitle">AI-powered landing page analysis that tells you exactly what's working, what's broken, and how to fix it.</p>
      </div>

      <!-- Screenshot Section (Full Width) -->
      <div class="video-section">
        <h2 class="section-title">See It in Action</h2>
        <div class="screenshot-wrapper">
          <Image src={ttmdImage} alt="Talk to Me Data - AI-powered landing page analytics" class="product-screenshot" width={1200} />
        </div>
      </div>

      <!-- Product Info Section -->
      <div class="info-section">
          <h2 class="section-title">What It Does</h2>

          <div class="feature-item">
            <div class="feature-icon">🔍</div>
            <div>
              <h3>Instant Page Analysis</h3>
              <p>Drop in your URL and get a full breakdown of your landing page — copy, layout, CTA placement, mobile responsiveness, and more.</p>
            </div>
          </div>

          <div class="feature-item">
            <div class="feature-icon">📊</div>
            <div>
              <h3>Conversion Scoring</h3>
              <p>Get a clear score on how well your page converts, with specific recommendations ranked by impact.</p>
            </div>
          </div>

          <div class="feature-item">
            <div class="feature-icon">🧠</div>
            <div>
              <h3>AI-Powered Suggestions</h3>
              <p>Receive actionable, plain-English suggestions to improve headlines, CTAs, trust signals, and page flow.</p>
            </div>
          </div>

          <div class="feature-item">
            <div class="feature-icon">📱</div>
            <div>
              <h3>Mobile & Speed Check</h3>
              <p>Know exactly how your page performs on mobile devices and where load times are costing you visitors.</p>
            </div>
          </div>
      </div>

      <!-- CTA Section -->
      <div class="cta-section">
        <h2>Try It Out</h2>
        <p>Try it out and share your feedback with me.</p>
        <a href="https://talktomedata.com/" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Check It Out →</a>
      </div>

      <!-- Back button -->
      <div style="text-align: center; margin: 40px 0;">
        <a href="/" class="btn btn-secondary">← Back to Home</a>
      </div>
    </div>
  </div>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Talk to Me Data",
    "description": "AI-powered landing page analytics tool that gives actionable insights to improve conversions and user experience.",
    "url": "https://www.sellingwithnas.com/tools/talk-to-me-data",
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "Web Browser",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "creator": {
      "@type": "Person",
      "name": "Nas",
      "url": "https://www.sellingwithnas.com"
    }
  }
  </script>
</Layout>

<style>
  .product-page {
    background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 50%, #bae6fd 100%);
    min-height: 100vh;
    color: #0f172a;
    overflow-x: hidden;
    padding-top: 80px;
  }

  .product-page * {
    box-sizing: border-box;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
    min-height: calc(100vh - 80px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* Hero */
  .hero-section {
    text-align: center;
    margin-bottom: 50px;
    position: relative;
  }

  .badge {
    display: inline-block;
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    color: white;
    padding: 6px 20px;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    margin-bottom: 20px;
    text-transform: uppercase;
  }

  .hero-section h1 {
    font-size: 3rem;
    font-weight: 700;
    background: linear-gradient(45deg, #3b82f6, #8b5cf6, #ef4444);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradientShift 3s ease-in-out infinite;
    margin: 0 0 16px 0;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: #475569;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  @keyframes gradientShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  @media (max-width: 768px) {
    .hero-section h1 {
      font-size: 2.2rem;
    }

    .container {
      padding: 15px;
    }

    .video-section, .info-section {
      padding: 20px;
    }
  }

  /* Sections */
  .video-section, .info-section {
    margin-bottom: 40px;
  }

  .video-section, .info-section {
    background: rgba(255, 255, 255, 0.9);
    border-radius: 20px;
    padding: 30px;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(59, 130, 246, 0.2);
    box-shadow: 0 20px 40px rgba(59, 130, 246, 0.1);
    transition: all 0.3s ease;
  }

  .video-section:hover, .info-section:hover {
    transform: translateY(-5px);
    box-shadow: 0 25px 50px rgba(59, 130, 246, 0.15);
  }

  .section-title {
    font-size: 1.8rem;
    margin-bottom: 25px;
    color: #3b82f6;
    text-align: center;
    position: relative;
  }

  .section-title::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 3px;
    background: linear-gradient(90deg, #3b82f6, #8b5cf6);
    border-radius: 2px;
  }

  /* Screenshot */
  .screenshot-wrapper {
    margin-top: 15px;
    border-radius: 16px;
    overflow: hidden;
    border: 2px solid rgba(59, 130, 246, 0.3);
    transition: all 0.3s ease;
  }

  .screenshot-wrapper:hover {
    border-color: rgba(59, 130, 246, 0.6);
    box-shadow: 0 10px 30px rgba(59, 130, 246, 0.2);
  }

  .product-screenshot {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Features */
  .feature-item {
    display: flex;
    gap: 16px;
    padding: 20px;
    margin-bottom: 16px;
    background: rgba(255, 255, 255, 0.6);
    border-radius: 14px;
    border: 1px solid rgba(59, 130, 246, 0.1);
    transition: all 0.3s ease;
  }

  .feature-item:hover {
    background: rgba(255, 255, 255, 0.9);
    transform: translateX(4px);
  }

  .feature-icon {
    font-size: 1.8rem;
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feature-item h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 6px 0;
  }

  .feature-item p {
    font-size: 0.95rem;
    color: #475569;
    margin: 0;
    line-height: 1.5;
  }

  /* CTA Section */
  .cta-section {
    text-align: center;
    padding: 50px 30px;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 20px;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(59, 130, 246, 0.2);
    box-shadow: 0 20px 40px rgba(59, 130, 246, 0.1);
    margin-bottom: 20px;
  }

  .cta-section h2 {
    font-size: 2rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 12px 0;
  }

  .cta-section p {
    color: #475569;
    font-size: 1.1rem;
    margin: 0 0 24px 0;
  }

  /* Buttons */
  .btn {
    display: inline-block;
    padding: 12px 24px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 600;
    text-align: center;
    transition: all 0.3s ease;
    backdrop-filter: blur(10px);
  }

  .btn-primary {
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    color: white;
    padding: 14px 32px;
    font-size: 1.05rem;
    border: none;
    box-shadow: 0 8px 25px rgba(59, 130, 246, 0.3);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 35px rgba(59, 130, 246, 0.4);
  }

  .btn-secondary {
    background: transparent;
    color: #3b82f6;
    border: 2px solid #3b82f6;
  }

  .btn-secondary:hover {
    background: #3b82f6;
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(59, 130, 246, 0.4);
  }

  /* Floating Elements */
  .floating-elements {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: -1;
  }

  .floating-circle {
    position: absolute;
    border-radius: 50%;
    background: linear-gradient(45deg, rgba(59, 130, 246, 0.1), rgba(139, 92, 246, 0.1));
    animation: float 6s ease-in-out infinite;
  }

  .floating-circle:nth-child(1) {
    width: 80px;
    height: 80px;
    top: 20%;
    left: 10%;
    animation-delay: 0s;
  }

  .floating-circle:nth-child(2) {
    width: 120px;
    height: 120px;
    top: 60%;
    right: 15%;
    animation-delay: 2s;
  }

  .floating-circle:nth-child(3) {
    width: 60px;
    height: 60px;
    bottom: 20%;
    left: 20%;
    animation-delay: 4s;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(180deg); }
  }

  /* Dark Mode */
  :global(.dark) .product-page {
    background: linear-gradient(135deg, #0f0f23 0%, #1a1a2e 50%, #16213e 100%);
    color: #ffffff;
  }

  :global(.dark) .hero-subtitle {
    color: #a0a0a0;
  }

  :global(.dark) .hero-section h1 {
    background: linear-gradient(45deg, #00d4ff, #5865f2, #ff6b6b);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: 0 0 30px rgba(0, 212, 255, 0.3);
  }

  :global(.dark) .video-section,
  :global(.dark) .info-section,
  :global(.dark) .cta-section {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
  }

  :global(.dark) .section-title {
    color: #00d4ff;
  }

  :global(.dark) .section-title::after {
    background: linear-gradient(90deg, #00d4ff, #5865f2);
  }

  :global(.dark) .screenshot-wrapper {
    border-color: rgba(0, 212, 255, 0.3);
  }

  :global(.dark) .screenshot-wrapper:hover {
    border-color: rgba(0, 212, 255, 0.6);
  }

  :global(.dark) .feature-item {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  :global(.dark) .feature-item:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  :global(.dark) .feature-item h3 {
    color: #e0e0e0;
  }

  :global(.dark) .feature-item p {
    color: #a0a0a0;
  }

  :global(.dark) .cta-section h2 {
    color: #e0e0e0;
  }

  :global(.dark) .cta-section p {
    color: #a0a0a0;
  }

  :global(.dark) .floating-circle {
    background: linear-gradient(45deg, rgba(0, 212, 255, 0.1), rgba(88, 101, 242, 0.1));
  }

  :global(.dark) .btn-secondary {
    color: #00d4ff;
    border-color: #00d4ff;
  }

  :global(.dark) .btn-secondary:hover {
    background: #00d4ff;
    color: #0f0f23;
  }

  :global(.dark) .btn-primary {
    background: linear-gradient(135deg, #00d4ff, #5865f2);
  }
</style>
