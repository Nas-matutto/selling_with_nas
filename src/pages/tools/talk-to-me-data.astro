---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Talk to Me Data — Build, Deploy & Host AI Agents for Your Business',
  description: 'Talk to Me Data helps businesses build, deploy, and host custom AI agents in days — not months. No code required. Full infrastructure managed for you.',
  keywords: 'AI agents for business, build AI agent, deploy AI agent, host AI agent, custom AI automation, no-code AI, AI workflow automation, Talk to Me Data',
  canonical: 'https://www.sellingwithnas.com/tools/talk-to-me-data',
  openGraph: {
    type: 'website',
    title: 'Talk to Me Data — AI Agents Built, Deployed & Hosted for You',
    description: 'Describe your workflow in plain language. We handle the rest — design, deployment, hosting, and ongoing management. Live in days, not months.',
    image: 'https://www.sellingwithnas.com/og-ttmd.png',
  },
};
---

<Layout metadata={metadata}>
  <div class="ttmd-page">

    <!-- Ambient background blobs -->
    <div class="ambient" aria-hidden="true">
      <div class="blob blob-1"></div>
      <div class="blob blob-2"></div>
      <div class="blob blob-3"></div>
    </div>

    <!-- ── HERO ── -->
    <section class="hero">
      <div class="container">
        <div class="badge-row">
          <span class="badge">AI Agents Platform</span>
        </div>

        <h1 class="hero-title">
          Build, Deploy &amp; Host<br />
          <span class="gradient-text">AI Agents for Your Business</span>
        </h1>

        <p class="hero-sub">
          Describe your workflow in plain language. We design, deploy, and manage
          custom AI agents that run 24/7 — live in days, not months.
        </p>

        <div class="hero-cta-row">
          <a href="https://talktomedata.com/" target="_blank" rel="noopener noreferrer" class="btn-primary">
            Get Your AI Agent →
          </a>
          <a href="#how-it-works" class="btn-ghost">See How It Works</a>
        </div>

        <!-- Stat pills -->
        <div class="stat-row">
          <div class="stat-pill">
            <span class="stat-num">24h</span>
            <span class="stat-label">Average go-live time</span>
          </div>
          <div class="stat-pill">
            <span class="stat-num">99.9%</span>
            <span class="stat-label">Uptime guarantee</span>
          </div>
          <div class="stat-pill">
            <span class="stat-num">0</span>
            <span class="stat-label">Lines of code you write</span>
          </div>
          <div class="stat-pill">
            <span class="stat-num">24/7</span>
            <span class="stat-label">Real-time monitoring</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ── HOW IT WORKS ── -->
    <section class="section" id="how-it-works">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">The Process</span>
          <h2 class="section-title">From idea to live agent — in three steps</h2>
          <p class="section-sub">No engineering team required. No months of waiting. Just results.</p>
        </div>

        <div class="steps">
          <div class="step">
            <div class="step-num gradient-text">01</div>
            <div class="step-icon">🧠</div>
            <h3>Build</h3>
            <p>Describe your workflow in plain language. We map it into a fully custom AI agent — trained on your business logic, tone, and tools.</p>
          </div>
          <div class="step-arrow">→</div>
          <div class="step">
            <div class="step-num gradient-text">02</div>
            <div class="step-icon">🚀</div>
            <h3>Deploy</h3>
            <p>Your agent goes live in ~24 hours, connected to your stack — Gmail, Zendesk, calendars, CRMs, and more. Zero downtime.</p>
          </div>
          <div class="step-arrow">→</div>
          <div class="step">
            <div class="step-num gradient-text">03</div>
            <div class="step-icon">⚙️</div>
            <h3>Host</h3>
            <p>We handle everything after launch — infrastructure, monitoring, updates, and automatic improvements as AI models advance.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── USE CASES ── -->
    <section class="section section-dark">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">Use Cases</span>
          <h2 class="section-title">What your AI agent can do</h2>
          <p class="section-sub">Any repetitive, language-based workflow is a candidate.</p>
        </div>

        <div class="use-case-grid">
          <div class="use-card">
            <div class="use-icon">💬</div>
            <h3>Customer Support</h3>
            <p>Handle FAQs, order tracking, and escalation routing — automatically, around the clock.</p>
          </div>
          <div class="use-card">
            <div class="use-icon">🎯</div>
            <h3>Lead Qualification</h3>
            <p>Score and route inbound leads in real time. Your sales team only talks to buyers who are ready.</p>
          </div>
          <div class="use-card">
            <div class="use-icon">📅</div>
            <h3>Booking & Scheduling</h3>
            <p>Let the agent handle appointment booking, reminders, and rescheduling without a human in the loop.</p>
          </div>
          <div class="use-card">
            <div class="use-icon">📄</div>
            <h3>Document Q&amp;A</h3>
            <p>Give the agent your SOPs, contracts, or knowledge base — it answers questions instantly and accurately.</p>
          </div>
          <div class="use-card">
            <div class="use-icon">📦</div>
            <h3>Order Notifications</h3>
            <p>Proactively update customers on order status, shipping changes, and delivery confirmations.</p>
          </div>
          <div class="use-card">
            <div class="use-icon">🔧</div>
            <h3>Custom Workflows</h3>
            <p>Any process that involves text, data, and decisions — we can automate it with a tailored agent.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── WHY TTMD ── -->
    <section class="section">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">Why Talk to Me Data</span>
          <h2 class="section-title">Built differently from the start</h2>
        </div>

        <div class="compare-grid">
          <div class="compare-card compare-bad">
            <h3>❌ Building in-house</h3>
            <ul>
              <li>3–6 months to ship</li>
              <li>Dedicated engineering team</li>
              <li>You manage infrastructure</li>
              <li>Maintenance on your plate</li>
              <li>Falls behind as AI evolves</li>
            </ul>
          </div>
          <div class="compare-card compare-good">
            <h3><span class="gradient-text">✦ Talk to Me Data</span></h3>
            <ul>
              <li>Live in ~24 hours</li>
              <li>Zero technical knowledge needed</li>
              <li>Fully managed hosting &amp; infra</li>
              <li>We handle every update</li>
              <li>Auto-improves with new AI models</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ── BUILDER STORY ── -->
    <section class="section section-dark">
      <div class="container">
        <div class="story-card">
          <div class="story-tag gradient-text">Built by Nas</div>
          <h2 class="story-title">Why I built this platform</h2>
          <div class="story-body">
            <p>
              I kept seeing the same problem: businesses <em>wanted</em> to use AI to automate their workflows,
              but every path forward required either hiring expensive engineers or settling for generic,
              one-size-fits-all chatbots that didn't actually fit their business.
            </p>
            <p>
              So I built Talk to Me Data — a platform where you describe what you need in plain English,
              and we handle everything else. The design, the integration, the deployment, the hosting, and
              the ongoing improvements.
            </p>
            <p>
              The goal was simple: make it possible for any business — regardless of technical sophistication —
              to have a custom AI agent working for them within 24 hours. Not a demo. Not a prototype.
              A real, production-grade agent that runs around the clock and gets better over time.
            </p>
          </div>
          <div class="story-author">
            <div class="author-avatar">N</div>
            <div>
              <div class="author-name">Nas</div>
              <div class="author-role">Founder, Talk to Me Data</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── FEATURES ── -->
    <section class="section">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">Platform Features</span>
          <h2 class="section-title">Everything managed, so you don't have to</h2>
        </div>

        <div class="feature-grid">
          <div class="feature-card">
            <div class="feature-icon-wrap">🔗</div>
            <h3>Multi-platform integrations</h3>
            <p>Gmail, Zendesk, Slack, calendar systems, CRMs — your agent plugs into your existing stack on day one.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon-wrap">📊</div>
            <h3>Real-time monitoring</h3>
            <p>24/7 oversight of every conversation, with uptime guarantees and instant alerts if anything needs attention.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon-wrap">🔒</div>
            <h3>Data security</h3>
            <p>Isolated environments per client. Your data is never used to train models. Privacy-first by design.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon-wrap">⚡</div>
            <h3>Automatic upgrades</h3>
            <p>As AI models improve, your agent does too — no migration work, no re-engineering. It just gets better.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon-wrap">🌐</div>
            <h3>Managed infrastructure</h3>
            <p>Hosting, scaling, backups, and maintenance are fully handled. You focus on your business, not servers.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon-wrap">💬</div>
            <h3>Plain-language setup</h3>
            <p>No technical knowledge required. Describe what you need in natural language — we translate it into a working agent.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── CTA ── -->
    <section class="section">
      <div class="container">
        <div class="cta-card">
          <div class="cta-glow" aria-hidden="true"></div>
          <span class="section-tag">Get Started</span>
          <h2 class="cta-title">
            Your AI agent could be live <span class="gradient-text">tomorrow.</span>
          </h2>
          <p class="cta-sub">
            Tell us what you want to automate. We'll design, build, and deploy your custom AI agent — fully managed, forever.
          </p>
          <a href="https://talktomedata.com/" target="_blank" rel="noopener noreferrer" class="btn-primary btn-large">
            Visit Talk to Me Data →
          </a>
        </div>
      </div>
    </section>

    <!-- ── BACK ── -->
    <div class="back-row">
      <a href="/" class="btn-ghost">← Back to Home</a>
    </div>

  </div>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Talk to Me Data",
    "description": "Talk to Me Data helps businesses build, deploy, and host custom AI agents in days. Describe your workflow in plain language — we handle design, deployment, hosting, and ongoing management.",
    "url": "https://www.sellingwithnas.com/tools/talk-to-me-data",
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "Web Browser",
    "featureList": [
      "Custom AI agent building",
      "Managed deployment and hosting",
      "Multi-platform integrations",
      "24/7 real-time monitoring",
      "Automatic AI model upgrades",
      "Data-isolated environments"
    ],
    "offers": {
      "@type": "Offer",
      "availability": "https://schema.org/InStock",
      "url": "https://talktomedata.com/"
    },
    "creator": {
      "@type": "Person",
      "name": "Nas",
      "url": "https://www.sellingwithnas.com"
    }
  }
  </script>
</Layout>

<style>
  /* ════════════════════════════════════════════
     LIGHT MODE (default)
  ════════════════════════════════════════════ */

  .ttmd-page {
    background: #ffffff;
    min-height: 100vh;
    color: #0f172a;
    overflow-x: hidden;
    position: relative;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ── Gradient text (same in both modes) ── */
  .gradient-text {
    background: linear-gradient(to right, #f97316, #60a5fa, #8b5cf6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* ── Ambient blobs ── */
  .ambient {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.08;
    animation: blobDrift 14s ease-in-out infinite alternate;
  }
  .blob-1 {
    width: 600px; height: 600px;
    background: #f97316;
    top: -150px; left: -150px;
    animation-delay: 0s;
  }
  .blob-2 {
    width: 500px; height: 500px;
    background: #60a5fa;
    top: 40%; right: -100px;
    animation-delay: 4s;
  }
  .blob-3 {
    width: 400px; height: 400px;
    background: #8b5cf6;
    bottom: -100px; left: 30%;
    animation-delay: 8s;
  }
  @keyframes blobDrift {
    from { transform: translate(0, 0) scale(1); }
    to   { transform: translate(40px, 30px) scale(1.08); }
  }

  .section, .hero, .back-row {
    position: relative;
    z-index: 1;
  }

  /* ── Hero ── */
  .hero {
    padding: 120px 0 80px;
    text-align: center;
  }
  .badge-row { margin-bottom: 24px; }
  .badge {
    display: inline-block;
    padding: 6px 18px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: linear-gradient(135deg, rgba(249,115,22,0.1), rgba(139,92,246,0.1));
    border: 1px solid rgba(249,115,22,0.35);
    color: #ea6a00;
  }
  .hero-title {
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: #0f172a;
    margin: 0 0 24px;
  }
  .hero-sub {
    font-size: 1.15rem;
    color: #475569;
    max-width: 600px;
    margin: 0 auto 40px;
    line-height: 1.7;
  }
  .hero-cta-row {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 60px;
  }

  /* ── Buttons ── */
  .btn-primary {
    display: inline-block;
    padding: 14px 32px;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    background: linear-gradient(135deg, #f97316, #60a5fa, #8b5cf6);
    color: #fff;
    box-shadow: 0 4px 24px rgba(96,165,250,0.3);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 36px rgba(96,165,250,0.4);
  }
  .btn-primary.btn-large {
    padding: 16px 40px;
    font-size: 1.1rem;
  }
  .btn-ghost {
    display: inline-block;
    padding: 14px 28px;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    color: #475569;
    border: 1px solid #e2e8f0;
    transition: all 0.2s ease;
  }
  .btn-ghost:hover {
    color: #0f172a;
    border-color: #94a3b8;
    background: #f8fafc;
  }

  /* ── Stat pills ── */
  .stat-row {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .stat-pill {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 16px 28px;
    border-radius: 14px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
  }
  .stat-num {
    font-size: 1.6rem;
    font-weight: 800;
    background: linear-gradient(to right, #f97316, #60a5fa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .stat-label {
    font-size: 0.78rem;
    color: #64748b;
    margin-top: 2px;
    text-align: center;
  }

  /* ── Sections ── */
  .section { padding: 96px 0; }
  .section-dark {
    background: #f8fafc;
    border-top: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
  }
  .section-header {
    text-align: center;
    margin-bottom: 56px;
  }
  .section-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #3b82f6;
    margin-bottom: 12px;
  }
  .section-title {
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 16px;
    letter-spacing: -0.025em;
  }
  .section-sub {
    color: #64748b;
    font-size: 1.05rem;
    max-width: 520px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* ── Steps ── */
  .steps {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .step {
    flex: 1;
    min-width: 220px;
    max-width: 300px;
    text-align: center;
    padding: 40px 28px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.05);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .step:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 28px rgba(96,165,250,0.15);
    border-color: #93c5fd;
  }
  .step-num {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    margin-bottom: 12px;
  }
  .step-icon { font-size: 2.2rem; margin-bottom: 16px; }
  .step h3 {
    font-size: 1.2rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 12px;
  }
  .step p {
    font-size: 0.92rem;
    color: #64748b;
    line-height: 1.6;
    margin: 0;
  }
  .step-arrow {
    font-size: 1.5rem;
    color: #cbd5e1;
    padding-top: 80px;
    flex-shrink: 0;
  }

  /* ── Use cases ── */
  .use-case-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }
  .use-card {
    padding: 32px 28px;
    border-radius: 18px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    transition: all 0.25s ease;
  }
  .use-card:hover {
    box-shadow: 0 8px 28px rgba(139,92,246,0.12);
    border-color: #c4b5fd;
    transform: translateY(-3px);
  }
  .use-icon { font-size: 2rem; margin-bottom: 16px; }
  .use-card h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 10px;
  }
  .use-card p {
    font-size: 0.9rem;
    color: #64748b;
    line-height: 1.6;
    margin: 0;
  }

  /* ── Compare ── */
  .compare-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    max-width: 800px;
    margin: 0 auto;
  }
  .compare-card { padding: 36px 32px; border-radius: 20px; }
  .compare-bad {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
  }
  .compare-good {
    background: linear-gradient(135deg, rgba(249,115,22,0.06), rgba(96,165,250,0.06), rgba(139,92,246,0.06));
    border: 1px solid rgba(96,165,250,0.3);
  }
  .compare-card h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 20px;
  }
  .compare-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .compare-card li {
    font-size: 0.92rem;
    color: #475569;
    padding-left: 0;
  }
  .compare-bad li::before { content: '— '; color: #94a3b8; }
  .compare-good li::before { content: '✓ '; color: #3b82f6; font-weight: 700; }

  /* ── Story ── */
  .story-card {
    max-width: 740px;
    margin: 0 auto;
    padding: 56px 48px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.06);
  }
  .story-tag {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 16px;
  }
  .story-title {
    font-size: 1.9rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 28px;
    letter-spacing: -0.025em;
  }
  .story-body p {
    color: #475569;
    line-height: 1.8;
    margin: 0 0 18px;
    font-size: 1rem;
  }
  .story-body em {
    color: #0f172a;
    font-style: normal;
    font-weight: 600;
  }
  .story-author {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 36px;
    padding-top: 28px;
    border-top: 1px solid #e2e8f0;
  }
  .author-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, #f97316, #8b5cf6);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    font-weight: 800;
    color: white;
    flex-shrink: 0;
  }
  .author-name { font-size: 0.95rem; font-weight: 700; color: #0f172a; }
  .author-role { font-size: 0.82rem; color: #64748b; margin-top: 2px; }

  /* ── Feature grid ── */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }
  .feature-card {
    padding: 32px 28px;
    border-radius: 18px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    transition: all 0.25s ease;
  }
