---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'LeadLanding - Build AI Landing Pages That Collect Leads | Selling with Nas',
  description: 'LeadLanding lets you build conversion-optimized landing pages with a single prompt, deploy live in one click, and collect leads automatically — no code, no domain required.',
  keywords: 'LeadLanding, AI landing page builder, landing page generator, lead capture tool, validate startup idea, AI landing page, lead generation tool, no-code landing page, landing page with lead form, product validation tool',
  canonical: 'https://www.sellingwithnas.com/tools/leadlanding',
};
---

<Layout metadata={metadata}>
  <div class="product-page">
    <div class="floating-elements">
      <div class="floating-circle"></div>
      <div class="floating-circle"></div>
      <div class="floating-circle"></div>
    </div>

    <div class="container">

      <!-- Hero Section -->
      <div class="hero-section">
        <div class="badge">Product</div>
        <h1>LeadLanding</h1>
        <p class="hero-subtitle">Build landing pages that collect leads. Describe your product, go live in under a minute, and start validating your idea before you write a single line of code.</p>
        <div class="hero-actions">
          <a href="https://www.leadlanding.dev/" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Start Building Free →</a>
          <a href="https://www.leadlanding.dev/features" target="_blank" rel="noopener noreferrer" class="btn btn-outline">See All Features</a>
        </div>
        <p class="hero-note">No credit card required · 7 AI generations included</p>
      </div>

      <!-- Why LeadLanding Section -->
      <div class="info-section">
        <h2 class="section-title"><b>Why LeadLanding?</b></h2>
        <p class="section-intro">Most founders waste weeks building something before they know if anyone wants it. LeadLanding flips that. You validate first — with a real landing page, real traffic, and real lead data — then build with confidence.</p>

        <div class="stat-row">
          <div class="stat-card">
            <div class="stat-number">&lt; 1 min</div>
            <div class="stat-label">From idea to live page</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">0</div>
            <div class="stat-label">Lines of code needed</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">1-click</div>
            <div class="stat-label">Lead form on every page</div>
          </div>
        </div>
      </div>

      <!-- Features Section -->
      <div class="info-section">
        <h2 class="section-title"><b>Key Features</b></h2>

        <div class="feature-item">
          <div class="feature-icon">⚡</div>
          <div>
            <h3>Instant Publishing — No Domain Required</h3>
            <p>Build your page and hit publish. LeadLanding gives you a live <strong>leadlanding.dev</strong> subdomain instantly — no Namecheap, no Vercel, no DNS configuration. Your page is online in seconds, ready to receive traffic.</p>
          </div>
        </div>

        <div class="feature-item">
          <div class="feature-icon">🤖</div>
          <div>
            <h3>AI Page Generation</h3>
            <p>Describe your product in plain language and LeadLanding generates a complete, conversion-optimized landing page — copy, layout, sections, and design — automatically. Not a rough draft. A polished page ready to share. Refine any detail with follow-up prompts.</p>
          </div>
        </div>

        <div class="feature-item">
          <div class="feature-icon">🎯</div>
          <div>
            <h3>Built-in Lead Capture on Every Page</h3>
            <p>Every page you build comes with an integrated lead capture form — no Typeform, no Zapier, no setup required. Submissions land directly in your dashboard the moment someone registers interest. This is your waitlist, built automatically.</p>
          </div>
        </div>

        <div class="feature-item">
          <div class="feature-icon">💬</div>
          <div>
            <h3>Chat to Refine</h3>
            <p>Don't like the headline? Want to change the color scheme? Just tell it. LeadLanding lets you fine-tune every element of your page using natural language — no drag-and-drop editor, no CSS. Type what you want, see it update.</p>
          </div>
        </div>

        <div class="feature-item">
          <div class="feature-icon">🎨</div>
          <div>
            <h3>Professional Templates</h3>
            <p>Start from a library of professionally designed templates built for specific use cases — SaaS products, agencies, wellness brands, and more. Pick one, describe your product, and ship faster. The AI handles customization from there.</p>
          </div>
        </div>

        <div class="feature-item">
          <div class="feature-icon">📊</div>
          <div>
            <h3>Built-in Analytics</h3>
            <p>See exactly how your page is performing — daily views, traffic patterns, peak times — all without installing Google Analytics or configuring a cookie banner. The data you need is already there when you log in.</p>
          </div>
        </div>

        <div class="feature-item">
          <div class="feature-icon">🔗</div>
          <div>
            <h3>Custom Domains (Coming Soon)</h3>
            <p>Point your own domain to any LeadLanding page with a single CNAME record. Keep your brand front and center while the platform handles everything else behind the scenes.</p>
          </div>
        </div>
      </div>

      <!-- How It Works Section -->
      <div class="info-section">
        <h2 class="section-title"><b>How It Works</b></h2>

        <div class="steps-grid">
          <div class="step-card">
            <div class="step-number">1</div>
            <h3>Describe Your Idea</h3>
            <p>Type a short description of your product or pick a template. Be as specific or as brief as you like — the AI handles the rest.</p>
          </div>
          <div class="step-card">
            <div class="step-number">2</div>
            <h3>Generate Your Page</h3>
            <p>LeadLanding builds a complete, conversion-optimized landing page in seconds. Refine the copy, layout, or design with follow-up prompts.</p>
          </div>
          <div class="step-card">
            <div class="step-number">3</div>
            <h3>Go Live in One Click</h3>
            <p>Hit publish and your page is instantly live on a leadlanding.dev subdomain. Share the link anywhere — social, email, ads.</p>
          </div>
          <div class="step-card">
            <div class="step-number">4</div>
            <h3>Collect Leads & Validate</h3>
            <p>The built-in lead form captures registrations automatically. Watch the dashboard fill up — and know which idea is worth building before you write a line of code.</p>
          </div>
        </div>
      </div>

      <!-- Who It's For Section -->
      <div class="info-section">
        <h2 class="section-title"><b>Who It's For</b></h2>
        <div class="use-case-grid">
          <div class="use-case-card">
            <div class="use-case-icon">🏗️</div>
            <h3>Indie Founders</h3>
            <p>Validate multiple ideas simultaneously without burning tokens on Claude Code or weeks on development. Find the idea with real pull, then build it.</p>
          </div>
          <div class="use-case-card">
            <div class="use-case-icon">🚀</div>
            <h3>Early-Stage Startups</h3>
            <p>Ship an MVP landing page before your product is ready. Start building your waitlist now and launch to an audience on day one.</p>
          </div>
          <div class="use-case-card">
            <div class="use-case-icon">📣</div>
            <h3>Marketers & Growth Teams</h3>
            <p>Spin up dedicated landing pages for campaigns, product features, or A/B tests in minutes — without waiting on engineering resources.</p>
          </div>
          <div class="use-case-card">
            <div class="use-case-icon">🛍️</div>
            <h3>E-Commerce Brands</h3>
            <p>Test new product concepts before committing to inventory. Run the landing page, measure interest, then order stock with confidence.</p>
          </div>
        </div>
      </div>

      <!-- CTA Section -->
      <div class="cta-section">
        <h2>Ready to Validate Your Next Idea?</h2>
        <p>Launch a landing page in under a minute. Collect leads before you build. Know which idea is worth your time.</p>
        <a href="https://www.leadlanding.dev/" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Try LeadLanding Free →</a>
      </div>

      <!-- Back button -->
      <div style="text-align: center; margin: 40px 0;">
        <a href="/" class="btn btn-secondary">← Back to Home</a>
      </div>

    </div>
  </div>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "LeadLanding",
    "description": "AI-powered landing page builder that generates conversion-optimized pages from a prompt, publishes instantly, and captures leads automatically.",
    "url": "https://www.leadlanding.dev/",
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "Web Browser",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD",
      "description": "Free plan with 7 AI generations included"
    },
    "featureList": [
      "AI-powered landing page generation",
      "1-click publish with instant subdomain",
      "Built-in lead capture forms",
      "Chat-based page refinement",
      "Professional templates",
      "Built-in analytics",
      "Custom domain support (coming soon)"
    ],
    "creator": {
      "@type": "Person",
      "name": "Nas",
      "url": "https://www.sellingwithnas.com"
    }
  }
  </script>
</Layout>

<style>
  .product-page {
    background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 40%, #fed7aa 100%);
    min-height: 100vh;
    color: #0f172a;
    overflow-x: hidden;
    padding-top: 80px;
  }

  .product-page * {
    box-sizing: border-box;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
  }

  /* Hero */
  .hero-section {
    text-align: center;
    margin-bottom: 50px;
    position: relative;
    padding: 20px 0;
  }

  .badge {
    display: inline-block;
    background: linear-gradient(135deg, #f97316, #ef4444);
    color: white;
    padding: 6px 20px;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    margin-bottom: 20px;
    text-transform: uppercase;
  }

  .hero-section h1 {
    font-size: 3.5rem;
    font-weight: 700;
    background: linear-gradient(45deg, #f97316, #ef4444, #a855f7);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradientShift 3s ease-in-out infinite;
    margin: 0 0 20px 0;
  }

  .hero-subtitle {
    font-size: 1.3rem;
    color: #475569;
    max-width: 680px;
    margin: 0 auto 28px auto;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .hero-note {
    font-size: 0.85rem;
    color: #94a3b8;
    margin: 0;
  }

  @keyframes gradientShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  /* Sections */
  .info-section {
    background: rgba(255, 255, 255, 0.9);
    border-radius: 20px;
    padding: 36px 30px;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(249, 115, 22, 0.2);
    box-shadow: 0 20px 40px rgba(249, 115, 22, 0.1);
    transition: all 0.3s ease;
    margin-bottom: 30px;
  }

  .info-section:hover {
    transform: translateY(-4px);
    box-shadow: 0 25px 50px rgba(249, 115, 22, 0.15);
  }

  .section-title {
    font-size: 1.8rem;
    margin-bottom: 10px;
    color: #f97316;
    text-align: center;
    position: relative;
    padding-bottom: 18px;
  }

  .section-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 3px;
    background: linear-gradient(90deg, #f97316, #ef4444);
    border-radius: 2px;
  }

  .section-intro {
    text-align: center;
    color: #475569;
    font-size: 1.05rem;
    max-width: 720px;
    margin: 16px auto 28px auto;
    line-height: 1.7;
  }

  /* Stats Row */
  .stat-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 10px;
  }

  .stat-card {
    text-align: center;
    padding: 24px 16px;
    background: linear-gradient(135deg, rgba(249,115,22,0.06), rgba(239,68,68,0.06));
    border-radius: 16px;
    border: 1px solid rgba(249,115,22,0.15);
  }

  .stat-number {
    font-size: 2.2rem;
    font-weight: 800;
    background: linear-gradient(135deg, #f97316, #ef4444);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 6px;
  }

  .stat-label {
    font-size: 0.9rem;
    color: #64748b;
    font-weight: 500;
  }

  /* Feature Items */
  .feature-item {
    display: flex;
    gap: 18px;
    padding: 22px;
    margin-bottom: 14px;
    background: rgba(255, 255, 255, 0.6);
    border-radius: 14px;
    border: 1px solid rgba(249, 115, 22, 0.1);
    transition: all 0.3s ease;
  }

  .feature-item:last-child {
    margin-bottom: 0;
  }

  .feature-item:hover {
    background: rgba(255, 255, 255, 0.95);
    transform: translateX(4px);
    border-color: rgba(249, 115, 22, 0.25);
  }

  .feature-icon {
    font-size: 1.8rem;
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feature-item h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 6px 0;
  }

  .feature-item p {
    font-size: 0.95rem;
    color: #475569;
    margin: 0;
    line-height: 1.6;
  }

  /* Steps Grid */
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 20px;
  }

  .step-card {
    padding: 24px;
    background: rgba(255,255,255,0.6);
    border-radius: 16px;
    border: 1px solid rgba(249,115,22,0.12);
    transition: all 0.3s ease;
    position: relative;
  }

  .step-card:hover {
    background: rgba(255,255,255,0.95);
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(249,115,22,0.1);
  }

  .step-number {
    width: 36px;
    height: 36px;
    background: linear-gradient(135deg, #f97316, #ef4444);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: 14px;
  }

  .step-card h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 8px 0;
  }

  .step-card p {
    font-size: 0.92rem;
    color: #475569;
    margin: 0;
    line-height: 1.6;
  }

  /* Use Case Grid */
  .use-case-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 20px;
  }

  .use-case-card {
    padding: 24px;
    background: rgba(255,255,255,0.6);
    border-radius: 16px;
    border: 1px solid rgba(249,115,22,0.12);
    transition: all 0.3s ease;
  }

  .use-case-card:hover {
    background: rgba(255,255,255,0.95);
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(249,115,22,0.1);
  }

  .use-case-icon {
    font-size: 2rem;
    margin-bottom: 12px;
  }

  .use-case-card h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 8px 0;
  }

  .use-case-card p {
    font-size: 0.92rem;
    color: #475569;
    margin: 0;
    line-height: 1.6;
  }

  /* CTA Section */
  .cta-section {
    text-align: center;
    padding: 56px 30px;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 20px;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(249, 115, 22, 0.2);
    box-shadow: 0 20px 40px rgba(249, 115, 22, 0.1);
    margin-bottom: 20px;
  }

  .cta-section h2 {
    font-size: 2.2rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 14px 0;
  }

  .cta-section p {
    color: #475569;
    font-size: 1.1rem;
    margin: 0 0 28px 0;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Buttons */
  .btn {
    display: inline-block;
    padding: 12px 24px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 600;
    text-align: center;
    transition: all 0.3s ease;
  }

  .btn-primary {
    background: linear-gradient(135deg, #f97316, #ef4444);
    color: white;
    padding: 14px 36px;
    font-size: 1.05rem;
    box-shadow: 0 8px 25px rgba(249, 115, 22, 0.3);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 35px rgba(249, 115, 22, 0.45);
  }

  .btn-outline {
    background: transparent;
    color: #f97316;
    border: 2px solid #f97316;
    padding: 12px 28px;
    font-size: 1.05rem;
  }

  .btn-outline:hover {
    background: rgba(249, 115, 22, 0.08);
    transform: translateY(-2px);
  }

  .btn-secondary {
    background: transparent;
    color: #f97316;
    border: 2px solid #f97316;
  }

  .btn-secondary:hover {
    background: #f97316;
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(249, 115, 22, 0.4);
  }

  /* Floating Elements */
  .floating-elements {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: -1;
  }

  .floating-circle {
    position: absolute;
    border-radius: 50%;
    background: linear-gradient(45deg, rgba(249, 115, 22, 0.1), rgba(239, 68, 68, 0.1));
    animation: float 6s ease-in-out infinite;
  }

  .floating-circle:nth-child(1) {
    width: 80px;
    height: 80px;
    top: 20%;
    left: 10%;
    animation-delay: 0s;
  }

  .floating-circle:nth-child(2) {
    width: 120px;
    height: 120px;
    top: 60%;
    right: 15%;
    animation-delay: 2s;
  }

  .floating-circle:nth-child(3) {
    width: 60px;
    height: 60px;
    bottom: 20%;
    left: 20%;
    animation-delay: 4s;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(180deg); }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero-section h1 {
      font-size: 2.4rem;
    }

    .hero-subtitle {
      font-size: 1.1rem;
    }

    .container {
      padding: 15px;
    }

    .stat-row {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .steps-grid,
    .use-case-grid {
      grid-template-columns: 1fr;
    }

    .info-section {
      padding: 24px 18px;
    }
  }

  /* Dark Mode */
  :global(.dark) .product-page {
    background: linear-gradient(135deg, #0f0f23 0%, #1a1a2e 50%, #16213e 100%);
    color: #ffffff;
  }

  :global(.dark) .hero-subtitle {
    color: #a0a0a0;
  }

  :global(.dark) .hero-section h1 {
    background: linear-gradient(45deg, #fb923c, #ef4444, #a855f7);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: none;
  }

  :global(.dark) .info-section,
  :global(.dark) .cta-section {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
  }

  :global(.dark) .section-title {
    color: #fb923c;
  }

  :global(.dark) .section-intro {
    color: #a0a0a0;
  }

  :global(.dark) .stat-card {
    background: linear-gradient(135deg, rgba(249,115,22,0.08), rgba(239,68,68,0.08));
    border-color: rgba(249,115,22,0.2);
  }

  :global(.dark) .stat-label {
    color: #94a3b8;
  }

  :global(.dark) .feature-item,
  :global(.dark) .step-card,
  :global(.dark) .use-case-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
  }

  :global(.dark) .feature-item:hover,
  :global(.dark) .step-card:hover,
  :global(.dark) .use-case-card:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  :global(.dark) .feature-item h3,
  :global(.dark) .step-card h3,
  :global(.dark) .use-case-card h3 {
    color: #e0e0e0;
  }

  :global(.dark) .feature-item p,
  :global(.dark) .step-card p,
  :global(.dark) .use-case-card p {
    color: #a0a0a0;
  }

  :global(.dark) .cta-section h2 {
    color: #e0e0e0;
  }

  :global(.dark) .cta-section p {
    color: #a0a0a0;
  }

  :global(.dark) .hero-note {
    color: #64748b;
  }

  :global(.dark) .btn-outline {
    color: #fb923c;
    border-color: #fb923c;
  }

  :global(.dark) .btn-outline:hover {
    background: rgba(251, 146, 60, 0.1);
  }

  :global(.dark) .btn-secondary {
    color: #fb923c;
    border-color: #fb923c;
  }

  :global(.dark) .btn-secondary:hover {
    background: #fb923c;
    color: #0f0f23;
  }

  :global(.dark) .btn-primary {
    background: linear-gradient(135deg, #fb923c, #ef4444);
  }
</style>
