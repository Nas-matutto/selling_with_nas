  .mc-bonus-right h3 { font-size: 1.2rem; font-weight: 800; color: #0f172a; margin: 0 0 10px; letter-spacing: -0.02em; }
  :global(.dark) .mc-bonus-right h3 { color: #f8fafc; }
  .mc-bonus-right p { font-size: 0.95rem; color: #475569; line-height: 1.7; margin: 0 0 10px; }
  :global(.dark) .mc-bonus-right p { color: #94a3b8; }
  .mc-bonus-note { font-size: 0.85rem !important; font-weight: 600; color: #c2410c !important; margin: 0 !important; }
  :global(.dark) .mc-bonus-note { color: #fb923c !important; }

  .mc-mid-cta { text-align: center; margin-top: 48px; display: flex; flex-direction: column; align-items: center; gap: 16px; }

  @media (max-width: 640px) {
    .mc-bonus-body { flex-direction: column; gap: 18px; align-items: center; text-align: center; }
  }

  /* ════ TIMELINE ════ */
  .mc-timeline {
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .mc-tl-item { display: flex; gap: 22px; align-items: flex-start; }
  .mc-tl-dot {
    width: 40px; height: 40px;
    flex-shrink: 0;
    border-radius: 50%;
    background: linear-gradient(135deg, #f97316, #a855f7);
    color: #fff;
    font-weight: 800;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  .mc-tl-item:not(:last-child) .mc-tl-dot::after {
    content: '';
    position: absolute;
    top: 46px;
    left: 50%;
    width: 2px;
    height: calc(100% + 24px);
    background: linear-gradient(to bottom, rgba(168,85,247,0.35), rgba(168,85,247,0.08));
    transform: translateX(-50%);
  }
  .mc-tl-body { padding-bottom: 32px; }
  .mc-tl-body h3 { font-size: 1.02rem; font-weight: 700; color: #0f172a; margin: 8px 0 8px; }
  :global(.dark) .mc-tl-body h3 { color: #f1f5f9; }
  .mc-tl-body p { font-size: 0.93rem; color: #64748b; line-height: 1.7; margin: 0; }

  /* ════ VALUE STACK ════ */
  .mc-stack {
    max-width: 620px;
    margin: 0 auto;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 22px;
    padding: 36px 34px;
    box-shadow: 0 4px 28px rgba(0,0,0,0.05);
    display: flex;
    flex-direction: column;
  }
  :global(.dark) .mc-stack { background: rgba(255,255,255,0.03); border-color: rgba(255,255,255,0.08); box-shadow: none; }
  .mc-stack-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px dashed #e2e8f0;
  }
  :global(.dark) .mc-stack-row { border-color: rgba(255,255,255,0.08); }
  .mc-stack-name { font-size: 0.93rem; color: #334155; line-height: 1.5; }
  :global(.dark) .mc-stack-name { color: #cbd5e1; }
  .mc-stack-val { font-size: 0.93rem; font-weight: 700; color: #64748b; white-space: nowrap; }
  .mc-stack-row-bonus .mc-stack-name { font-weight: 700; color: #0f172a; }
  :global(.dark) .mc-stack-row-bonus .mc-stack-name { color: #f1f5f9; }
  .mc-stack-row-bonus .mc-stack-val { color: #f97316; }

  .mc-stack-total { padding: 22px 0 24px; display: flex; flex-direction: column; gap: 8px; }
  .mc-stack-total-line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 0.95rem;
    color: #64748b;
  }
  .mc-strike { text-decoration: line-through; color: #94a3b8; font-weight: 600; }
  .mc-stack-today { margin-top: 6px; align-items: center; }
  .mc-stack-today span:first-child { font-size: 1.05rem; font-weight: 800; color: #0f172a; }
  :global(.dark) .mc-stack-today span:first-child { color: #f8fafc; }
  .mc-stack-today-num { font-size: 2.6rem; font-weight: 800; letter-spacing: -0.04em; line-height: 1; }
  .mc-stack-foot { font-size: 0.85rem; color: #64748b; text-align: center; margin: 14px 0 0; }

  /* ════ WHO IT'S FOR ════ */
  .mc-for-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
    max-width: 860px;
    margin: 0 auto;
  }
  .mc-for-card { padding: 36px 32px; border-radius: 20px; }
  .mc-for-yes { background: linear-gradient(135deg, rgba(168,85,247,0.07), rgba(249,115,22,0.05)); border: 1px solid rgba(168,85,247,0.2); }
  .mc-for-no  { background: #fff; border: 1px solid #e2e8f0; }
  :global(.dark) .mc-for-no { background: rgba(255,255,255,0.03); border-color: rgba(255,255,255,0.07); }
  .mc-for-card h3 { font-size: 1.05rem; font-weight: 700; color: #0f172a; margin: 0 0 20px; }
  :global(.dark) .mc-for-card h3 { color: #f1f5f9; }
  .mc-for-card ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px; }
  .mc-for-card li { font-size: 0.92rem; color: #475569; line-height: 1.55; }
  :global(.dark) .mc-for-card li { color: #94a3b8; }

  /* ════ ABOUT ════ */
  .mc-about-card {
    display: flex;
    gap: 40px;
    align-items: flex-start;
    max-width: 820px;
    margin: 0 auto;
    padding: 52px 48px;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.05);
  }
  :global(.dark) .mc-about-card { background: rgba(255,255,255,0.03); border-color: rgba(255,255,255,0.08); box-shadow: none; }
  .mc-about-avatar {
    width: 80px; height: 80px; flex-shrink: 0;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid rgba(168,85,247,0.3);
  }
  .mc-about-name { font-size: 1.6rem; font-weight: 800; color: #0f172a; margin: 0 0 16px; }
  :global(.dark) .mc-about-name { color: #f8fafc; }
  .mc-about-bio { font-size: 0.97rem; color: #475569; line-height: 1.8; margin: 0 0 14px; }
  :global(.dark) .mc-about-bio { color: #94a3b8; }
  .mc-about-links { display: flex; gap: 16px; margin-top: 8px; flex-wrap: wrap; }
  .mc-about-link { font-size: 0.88rem; font-weight: 700; color: #a855f7; text-decoration: none; }
  .mc-about-link:hover { text-decoration: underline; }

  /* ════ FAQ ════ */
  .mc-faq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
    max-width: 900px;
    margin: 0 auto;
  }
  .mc-faq-item {
    padding: 28px 24px;
    border-radius: 16px;
    background: #fff;
    border: 1px solid #e2e8f0;
  }
  :global(.dark) .mc-faq-item { background: rgba(255,255,255,0.03); border-color: rgba(255,255,255,0.07); }
  .mc-faq-item h3 { font-size: 0.97rem; font-weight: 700; color: #0f172a; margin: 0 0 10px; }
  :global(.dark) .mc-faq-item h3 { color: #f1f5f9; }
  .mc-faq-item p { font-size: 0.88rem; color: #64748b; line-height: 1.7; margin: 0; }

  /* ════ FINAL CTA ════ */
  .mc-final-cta {
    text-align: center;
    padding: 84px 40px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 28px;
    position: relative;
    overflow: hidden;
  }
  :global(.dark) .mc-final-cta { background: rgba(255,255,255,0.025); border-color: rgba(255,255,255,0.08); }
  .mc-final-glow {
    position: absolute;
    width: 600px; height: 300px;
    background: radial-gradient(ellipse, rgba(168,85,247,0.1) 0%, transparent 70%);
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  .mc-final-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #a855f7;
    margin-bottom: 20px;
    position: relative;
  }
  .mc-final-title {
    font-size: clamp(1.7rem, 3.5vw, 2.5rem);
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 20px;
    letter-spacing: -0.03em;
    line-height: 1.2;
    position: relative;
  }
  :global(.dark) .mc-final-title { color: #f8fafc; }
