  /* ════ AMBIENT ════ */
  .mc-ambient {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }
  .mc-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(130px);
    opacity: 0.06;
    animation: mcDrift 16s ease-in-out infinite alternate;
  }
  :global(.dark) .mc-blob { opacity: 0.15; }
  .mc-blob-1 { width: 600px; height: 600px; background: #f97316; top: -100px; left: -100px; animation-delay: 0s; }
  .mc-blob-2 { width: 500px; height: 500px; background: #a855f7; top: 40%; right: -100px; animation-delay: 5s; }
  .mc-blob-3 { width: 400px; height: 400px; background: #f97316; bottom: 0; left: 30%; animation-delay: 10s; }
  @keyframes mcDrift {
    from { transform: translate(0, 0) scale(1); }
    to   { transform: translate(30px, 20px) scale(1.06); }
  }
  @media (prefers-reduced-motion: reduce) {
    .mc-blob { animation: none; }
  }
  .mc-hero, .mc-section, .mc-proof-strip, .mc-back-row { position: relative; z-index: 1; }

  /* ════ HERO ════ */
  .mc-hero { padding: 80px 0 72px; }

  .mc-hero-split {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 56px;
    align-items: center;
  }
  .mc-hero-left { display: flex; flex-direction: column; align-items: flex-start; }
  .mc-ghost-inline { margin-top: 8px; }

  .mc-hero-title {
    font-size: clamp(1.75rem, 3.4vw, 2.6rem);
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -0.03em;
    color: #0f172a;
