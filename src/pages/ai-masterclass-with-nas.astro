  }
  :global(.dark) .mc-btn-ghost { color: #94a3b8; border-color: rgba(255,255,255,0.1); }
  .mc-btn-ghost:hover { color: #0f172a; border-color: #94a3b8; background: #f8fafc; }
  :global(.dark) .mc-btn-ghost:hover { color: #f8fafc; background: rgba(255,255,255,0.06); }

  .mc-guarantee { font-size: 0.83rem; color: #64748b; margin: 0; }

  /* ════ PROOF STRIP ════ */
  .mc-proof-strip {
    background: #f8fafc;
    border-top: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
    padding: 28px 0;
  }
  :global(.dark) .mc-proof-strip { background: rgba(255,255,255,0.03); border-color: rgba(255,255,255,0.06); }
  .mc-proof-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px;
  }
  .mc-proof-item { text-align: center; padding: 0 16px; }
  .mc-proof-num {
    display: block;
    font-size: 1.5rem;
    font-weight: 800;
    background: linear-gradient(to right, #f97316, #a855f7);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .mc-proof-label { font-size: 0.78rem; color: #64748b; margin-top: 2px; display: block; }
  .mc-proof-div { width: 1px; height: 36px; background: #e2e8f0; }
  :global(.dark) .mc-proof-div { background: rgba(255,255,255,0.08); }

  /* ════ SECTIONS ════ */
  .mc-section { padding: 88px 0; }
  .mc-section-alt {
    background: #f8fafc;
    border-top: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
  }
  :global(.dark) .mc-section-alt { background: rgba(255,255,255,0.025); border-color: rgba(255,255,255,0.06); }
  .mc-section-header { text-align: center; margin-bottom: 52px; }
  .mc-tag {
    display: inline-block;
