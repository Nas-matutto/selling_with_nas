<script>
  // Reveal the sticky buy bar once the hero offer card has scrolled out of view,
  // and hide it again over the final CTA so the two don't fight each other.
  const bar = document.getElementById('mc-sticky');
  const hero = document.querySelector('.mc-hero-booking-card');
  const final = document.querySelector('.mc-final-cta');

  if (bar && hero) {
    let pastHero = false;
    let atFinal = false;

    const sync = () => {
      const show = pastHero && !atFinal;
      bar.classList.toggle('mc-sticky-on', show);
      bar.setAttribute('aria-hidden', show ? 'false' : 'true');
    };

    new IntersectionObserver(
      ([e]) => {
        pastHero = !e.isIntersecting && e.boundingClientRect.top < 0;
        sync();
      },
      { threshold: 0 }
    ).observe(hero);

    if (final) {
      new IntersectionObserver(
        ([e]) => {
          atFinal = e.isIntersecting;
          sync();
        },
        { threshold: 0.2 }
      ).observe(final);
    }
  }
</script>

<style>
  /* ════ BASE ════ */
  .mc-page {
    background: #ffffff;
    color: #0f172a;
    min-height: 100vh;
    overflow-x: hidden;
    position: relative;
  }
  :global(.dark) .mc-page { background: #05050f; color: #e2e8f0; }

  .mc-container {
