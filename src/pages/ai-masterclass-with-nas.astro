---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import nasProfile from '~/assets/images/nas-profile.jpg';

const metadata = {
  title: 'Build Your Side-Hustle with Claude - Step-by-Step Pack + 1-on-1 Call',
  description:
    'The complete step-by-step pack for launching your side-hustle with Claude: build the website and deploy it on a live domain - plus a private 1-on-1 call with Nas. Was $150, now $97.',
