    'build a business with Claude, Claude Code side hustle, build a website with AI, deploy website live domain, Claude Code guide, AI side hustle, start online business with AI',
  canonical: 'https://www.sellingwithnas.com/ai-masterclass-with-nas',
};

// ─────────────────────────────────────────────────────────────
// TODO: paste the real checkout URL here (Stripe / Gumroad / Whop).
// Every CTA on this page reads from this one constant.
const CHECKOUT_LINK = '#';
// ─────────────────────────────────────────────────────────────

const PRICE_NOW = '97';
const PRICE_WAS = '150';

const faqs = [
  {
    q: 'Do I need to know how to code?',
    a: "No. Not a single line. Every step is done by talking to Claude in plain English - I show you exactly what to type and exactly what to click. If you can write an email, you can finish this pack.",
  },
  {
    q: 'What do I actually end up with?',
    a: "A real website, live on the internet, on your own domain, with HTTPS and a padlock in the browser bar. Not a mockup. Not a localhost demo. Something you can send to a customer today.",
  },
  {
    q: 'How long does it take?',
    a: "Most people get their site live in a single afternoon. Build it, then put it online - comfortably a weekend, even taking your time. You go at your own pace, and the guides do not expire.",
  },
  {
    q: 'What does the 1-on-1 call cover?',
    a: "Whatever is blocking you. Stuck on the deploy? Domain not pointing correctly? Not sure what to build in the first place? We get on a call, screen-share, and clear it. Your booking link is sent the moment you buy.",
  },
  {
    q: 'Do I need a paid Claude account?',
    a: "You can start on the free plan, but Claude Pro makes this dramatically smoother and is what I use throughout the guides. You will also need a domain (about $10/year) - hosting on the setup I teach is free.",
  },
  {
    q: 'Why is it $97 and not $150?',
    a: "This is the launch price while I gather the first wave of results and testimonials. It goes back to $150 once that is done. Buy now and you keep every future update to the pack at no extra cost.",
  },
  {
    q: 'Is this a subscription?',
    a: "No. One payment, lifetime access, including every update I make to the guides. No upsells, no recurring anything.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Build Your Side-Hustle with Claude - Step-by-Step Pack',
  description:
    'Step-by-step guides to build a website with Claude and deploy it on a live domain - plus a private 1-on-1 call with Nas.',
  brand: { '@type': 'Brand', name: 'Selling with Nas' },
  offers: {
    '@type': 'Offer',
    price: PRICE_NOW,
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: metadata.canonical,
  },
};
---

<Layout metadata={metadata}>
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

