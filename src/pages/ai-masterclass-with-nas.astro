  .mc-section-sub { font-size: 1.02rem; color: #64748b; max-width: 560px; margin: 0 auto; line-height: 1.65; }

  /* ════ PAIN GRID ════ */
  .mc-pain-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    max-width: 880px;
    margin: 0 auto;
  }
  .mc-pain-card {
    padding: 28px 26px;
    border-radius: 18px;
    background: #fff;
    border: 1px solid #e2e8f0;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }
  :global(.dark) .mc-pain-card { background: rgba(255,255,255,0.03); border-color: rgba(255,255,255,0.07); box-shadow: none; }
  .mc-pain-icon { font-size: 1.7rem; margin-bottom: 12px; }
  .mc-pain-card h3 { font-size: 1rem; font-weight: 700; color: #0f172a; margin: 0 0 8px; line-height: 1.4; }
  :global(.dark) .mc-pain-card h3 { color: #f1f5f9; }
  .mc-pain-card p { font-size: 0.9rem; color: #64748b; line-height: 1.65; margin: 0; }
  .mc-pain-card code {
    font-size: 0.85em;
    background: #f1f5f9;
    padding: 1px 6px;
    border-radius: 5px;
    color: #475569;
  }
  :global(.dark) .mc-pain-card code { background: rgba(255,255,255,0.07); color: #cbd5e1; }

  .mc-bridge { text-align: center; margin-top: 48px; }
  .mc-bridge p {
    font-size: 1.05rem;
    color: #475569;
    max-width: 620px;
    margin: 0 auto 28px;
    line-height: 1.7;
  }
  :global(.dark) .mc-bridge p { color: #94a3b8; }
  .mc-bridge strong { color: #0f172a; }
  :global(.dark) .mc-bridge strong { color: #e2e8f0; }

  /* ════ WHAT'S INSIDE ════ */
  .mc-learn-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 20px;
  }
  .mc-learn-grid-3 { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); max-width: 800px; margin: 0 auto; }
  .mc-learn-card {
    padding: 32px 28px;
    border-radius: 18px;
    background: #fff;
    border: 1px solid #e2e8f0;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    position: relative;
    transition: all 0.22s ease;
  }
  :global(.dark) .mc-learn-card { background: rgba(255,255,255,0.03); border-color: rgba(255,255,255,0.07); box-shadow: none; }
  .mc-learn-card:hover { transform: translateY(-3px); border-color: rgba(168,85,247,0.3); box-shadow: 0 8px 28px rgba(168,85,247,0.1); }
  :global(.dark) .mc-learn-card:hover { box-shadow: none; }
  .mc-learn-num {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #a855f7;
    margin-bottom: 10px;
  }
  .mc-learn-icon { font-size: 1.9rem; margin-bottom: 14px; }
  .mc-learn-card h3 { font-size: 1.05rem; font-weight: 700; color: #0f172a; margin: 0 0 10px; line-height: 1.35; }
  :global(.dark) .mc-learn-card h3 { color: #f1f5f9; }
  .mc-learn-card > p { font-size: 0.9rem; color: #64748b; line-height: 1.65; margin: 0 0 16px; }
  .mc-learn-list {
    list-style: none;
    padding: 16px 0 0;
    margin: 0;
    border-top: 1px solid #e2e8f0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  :global(.dark) .mc-learn-list { border-color: rgba(255,255,255,0.07); }
  .mc-learn-list li {
    font-size: 0.85rem;
    color: #475569;
    line-height: 1.5;
    padding-left: 20px;
    position: relative;
  }
  .mc-learn-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: #f97316;
    font-weight: 700;
  }
  :global(.dark) .mc-learn-list li { color: #94a3b8; }

  /* ── Bonus call card ── */
  .mc-bonus-card {
    margin-top: 24px;
    padding: 34px 32px;
    border-radius: 20px;
    background: linear-gradient(135deg, rgba(249,115,22,0.07), rgba(168,85,247,0.07));
    border: 1.5px solid rgba(249,115,22,0.28);
    position: relative;
  }
  :global(.dark) .mc-bonus-card {
    background: linear-gradient(135deg, rgba(249,115,22,0.1), rgba(168,85,247,0.1));
    border-color: rgba(249,115,22,0.3);
  }
  .mc-bonus-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    background: linear-gradient(135deg, #f97316, #a855f7);
    padding: 5px 14px;
    border-radius: 999px;
    margin-bottom: 18px;
  }
  .mc-bonus-body { display: flex; gap: 26px; align-items: flex-start; }
  .mc-bonus-avatar {
    width: 72px; height: 72px;
    flex: 0 0 72px;
    min-width: 72px;
    max-width: 72px;
    border-radius: 50%;
