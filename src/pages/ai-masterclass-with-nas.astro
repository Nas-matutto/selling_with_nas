    letter-spacing: -0.01em;
  }
  .mc-btn-book:hover { transform: translateY(-2px); box-shadow: 0 8px 40px rgba(249,115,22,0.4); }
  .mc-btn-book-lg { padding: 18px 44px; font-size: 1.1rem; }
  .mc-btn-ghost {
    display: inline-block;
    padding: 15px 28px;
    border-radius: 14px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
