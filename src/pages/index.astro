---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Selling with Nas - AI Builder · Founder · GTM Strategist',
  description: 'Helping founders and brands move faster with AI, automation, and Go-To-Market strategy that actually ships.',
  ignoreTitleTemplate: true,
};
---

<style>
  /* ─── CSS TOKENS ─── */
  .hp {
    --hp-bg:           #fafbff;
    --hp-bg-2:         #f1f5fb;
    --hp-card:         rgba(255,255,255,0.8);
    --hp-card-hover:   rgba(255,255,255,1);
    --hp-border:       rgba(0,0,0,0.08);
    --hp-border-hover: rgba(249,115,22,0.6);
    --hp-text:         #0f172a;
    --hp-muted:        #64748b;
    --hp-subtle:       #94a3b8;
    --hp-orange:       #f97316;
    --hp-purple:       #a855f7;
    --hp-cyan:         #22d3ee;
    --hp-grad-brand:   linear-gradient(135deg, #f97316 0%, #ef4444 45%, #a855f7 100%);
    --hp-grad-warm:    linear-gradient(135deg, #f97316, #f59e0b);
    --hp-max-w:        1140px;
    --hp-radius:       16px;
    --hp-radius-sm:    10px;
    --hp-radius-pill:  999px;
    --hp-ease:         cubic-bezier(0.4, 0, 0.2, 1);
    --hp-t:            0.25s;
    font-family: 'Inter Variable', 'Inter', -apple-system, 'Segoe UI', sans-serif;
  }
  :global(.dark) .hp {
    --hp-bg:           #07080f;
    --hp-bg-2:         #0c0e1a;
    --hp-card:         rgba(255,255,255,0.04);
    --hp-card-hover:   rgba(255,255,255,0.07);
    --hp-border:       rgba(255,255,255,0.08);
    --hp-border-hover: rgba(249,115,22,0.5);
    --hp-text:         #f1f5f9;
    --hp-muted:        #8899aa;
    --hp-subtle:       #4b5563;
  }

  /* ─── AURORA ─── */
  .aurora {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    opacity: 0.6;
  }
  :global(.dark) .aurora { opacity: 1; }
  .aurora-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 1;
  }
  .ab1 {
    width: 700px; height: 700px;
    top: -200px; left: -200px;
    background: radial-gradient(circle, rgba(249,115,22,0.28), transparent 68%);
    animation: hpDrift1 22s ease-in-out infinite;
  }
  .ab2 {
    width: 600px; height: 600px;
    top: -100px; right: -180px;
    background: radial-gradient(circle, rgba(168,85,247,0.22), transparent 68%);
    animation: hpDrift2 28s ease-in-out infinite;
  }
  .ab3 {
    width: 500px; height: 500px;
    top: 40vh; left: 35%;
    background: radial-gradient(circle, rgba(239,68,68,0.14), transparent 68%);
    animation: hpDrift3 18s ease-in-out infinite;
  }
  .ab4 {
    width: 400px; height: 400px;
    bottom: 10vh; left: -100px;
    background: radial-gradient(circle, rgba(34,211,238,0.16), transparent 68%);
    animation: hpDrift4 24s ease-in-out infinite;
  }
  .ab5 {
    width: 550px; height: 550px;
    bottom: -100px; right: -80px;
    background: radial-gradient(circle, rgba(245,158,11,0.2), transparent 68%);
    animation: hpDrift1 30s ease-in-out infinite reverse;
  }
  @keyframes hpDrift1 {
    0%, 100% { transform: translate(0,0) scale(1); }
    33%       { transform: translate(40px,-25px) scale(1.06); }
    66%       { transform: translate(-30px,35px) scale(0.94); }
  }
  @keyframes hpDrift2 {
    0%, 100% { transform: translate(0,0) scale(1); }
    33%       { transform: translate(-50px,30px) scale(1.04); }
    66%       { transform: translate(35px,-40px) scale(0.96); }
  }
  @keyframes hpDrift3 {
    0%, 100% { transform: translate(0,0); }
    50%       { transform: translate(-45px,50px) scale(1.08); }
  }
  @keyframes hpDrift4 {
    0%, 100% { transform: translate(0,0); }
    50%       { transform: translate(60px,-35px) scale(1.05); }
  }

  /* ─── LAYOUT HELPERS ─── */
  .hp-main { position: relative; z-index: 1; }
  .hp-container {
    max-width: var(--hp-max-w);
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ─── TYPOGRAPHY ─── */
  .hp-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--hp-orange);
  }
  .hp-label::before {
    content: '';
    display: block;
    width: 20px; height: 2px;
    background: var(--hp-grad-warm);
    border-radius: 2px;
  }
  .hp-grad-text {
    background: var(--hp-grad-brand);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* ─── BUTTONS ─── */
  .hp-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 26px;
    border-radius: var(--hp-radius-pill);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    border: none;
    transition: all var(--hp-t) var(--hp-ease);
    white-space: nowrap;
  }
  .hp-btn-primary {
    background: var(--hp-grad-brand);
    color: #fff;
    box-shadow: 0 4px 24px rgba(249,115,22,0.35);
  }
  .hp-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(249,115,22,0.45);
  }
  .hp-btn-ghost {
    background: var(--hp-card);
    color: var(--hp-text);
    border: 1px solid var(--hp-border);
    backdrop-filter: blur(12px);
  }
  .hp-btn-ghost:hover {
    background: var(--hp-card-hover);
    border-color: var(--hp-border-hover);
    transform: translateY(-2px);
  }
  .hp-btn-youtube {
    background: #FF0000;
    color: #fff;
    box-shadow: 0 4px 20px rgba(255,0,0,0.3);
  }
  .hp-btn-youtube:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(255,0,0,0.42);
  }

  /* ─── HERO ─── */
  #hp-hero {
    min-height: 92vh;
    display: flex;
    align-items: center;
    padding: 80px 0;
  }
  .hp-hero-inner { max-width: 820px; }
  .hp-hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 16px 6px 10px;
    border-radius: var(--hp-radius-pill);
    background: rgba(249,115,22,0.1);
    border: 1px solid rgba(249,115,22,0.25);
    margin-bottom: 32px;
    animation: hpFadeUp 0.7s ease both 0.1s;
  }
  .hp-eyebrow-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--hp-orange);
    animation: hpPulse 2s ease-in-out infinite;
  }
  @keyframes hpPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.6; transform: scale(0.85); }
  }
  .hp-eyebrow-text {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--hp-orange);
  }
  .hp-hero-h1 {
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 1.06;
    letter-spacing: -0.04em;
    font-weight: 800;
    color: var(--hp-text);
    margin-bottom: 28px;
    animation: hpFadeUp 0.7s ease both 0.2s;
  }
  .hp-hero-sub {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--hp-muted);
    max-width: 580px;
    line-height: 1.65;
    margin-bottom: 44px;
    animation: hpFadeUp 0.7s ease both 0.3s;
  }
  .hp-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    animation: hpFadeUp 0.7s ease both 0.4s;
  }
  @keyframes hpFadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ─── YOUTUBE SECTION ─── */
  #hp-youtube { padding: 80px 0 100px; }
  .hp-yt-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 56px;
    align-items: center;
  }
  @media (max-width: 860px) {
    .hp-yt-grid { grid-template-columns: 1fr; gap: 32px; }
  }
  .hp-yt-video-wrap {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    background: #000;
    aspect-ratio: 16 / 9;
    box-shadow:
      0 0 0 1px rgba(249,115,22,0.2),
      0 24px 72px rgba(0,0,0,0.5),
      0 0 80px rgba(249,115,22,0.08);
  }
  .hp-yt-video-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    border: none;
  }
  .hp-yt-title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--hp-text);
    margin: 14px 0 16px;
    line-height: 1.2;
  }
  .hp-yt-desc {
    color: var(--hp-muted);
    font-size: 0.97rem;
    line-height: 1.72;
    margin-bottom: 28px;
  }
  .hp-yt-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
  }
  .hp-yt-topic {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 5px 12px;
    border-radius: var(--hp-radius-pill);
    background: var(--hp-card);
    border: 1px solid var(--hp-border);
    color: var(--hp-muted);
  }
  .hp-yt-topic-dot { width: 6px; height: 6px; border-radius: 50%; }

  /* ─── EXPERTISE BENTO ─── */
  #hp-expertise { padding: 100px 0; }
  .hp-section-header { margin-bottom: 52px; }
  .hp-section-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--hp-text);
    margin-top: 14px;
  }
  .hp-section-sub {
    font-size: 1.05rem;
    color: var(--hp-muted);
    margin-top: 12px;
    max-width: 480px;
    line-height: 1.65;
  }
  .hp-bento {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: auto auto;
    gap: 16px;
  }
  .hp-bento-card {
    background: var(--hp-card);
    border: 1px solid var(--hp-border);
    border-radius: var(--hp-radius);
    padding: 36px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: all var(--hp-t) var(--hp-ease);
    position: relative;
    overflow: hidden;
    box-shadow: 0 2px 16px rgba(0,0,0,0.06);
  }
  :global(.dark) .hp-bento-card { box-shadow: none; }
  .hp-bento-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--hp-radius);
    opacity: 0;
    transition: opacity var(--hp-t) var(--hp-ease);
    background: radial-gradient(600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(249,115,22,0.06), transparent 40%);
  }
  .hp-bento-card:hover {
    border-color: rgba(249,115,22,0.3);
    transform: translateY(-3px);
    box-shadow: 0 8px 32px rgba(249,115,22,0.12);
  }
  :global(.dark) .hp-bento-card:hover { box-shadow: 0 12px 40px rgba(0,0,0,0.25); }
  .hp-bento-card:hover::before { opacity: 1; }
  .hp-bc-1 { grid-column: span 7; }
  .hp-bc-2 { grid-column: span 5; }
  .hp-bc-3 { grid-column: span 4; }
  .hp-bc-4 { grid-column: span 8; }
  @media (max-width: 900px) {
    .hp-bc-1, .hp-bc-2, .hp-bc-3, .hp-bc-4 { grid-column: span 12; }
  }
  @media (min-width: 901px) and (max-width: 1100px) {
    .hp-bc-1, .hp-bc-2, .hp-bc-3, .hp-bc-4 { grid-column: span 6; }
  }
  .hp-bento-icon {
    width: 52px; height: 52px;
    border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.6rem;
    margin-bottom: 24px;
  }
  .hp-bento-card h3 {
    font-size: 1.3rem; font-weight: 700;
    color: var(--hp-text); margin-bottom: 10px;
    letter-spacing: -0.025em;
  }
  .hp-bento-card p { font-size: 0.95rem; color: var(--hp-muted); line-height: 1.65; }
  .hp-bento-tag {
    display: inline-block;
    font-size: 0.72rem; font-weight: 700;
    letter-spacing: 0.07em; text-transform: uppercase;
    padding: 4px 10px;
    border-radius: var(--hp-radius-pill);
    margin-bottom: 16px;
  }
  .hp-bento-large {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 800; letter-spacing: -0.03em;
    color: var(--hp-text); line-height: 1.2; margin-bottom: 12px;
  }

  /* ─── SERVICES ─── */
  #hp-services { padding: 100px 0; position: relative; }
  .hp-services-bg {
    position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(249,115,22,0.04) 0%, transparent 50%, rgba(168,85,247,0.04) 100%);
    pointer-events: none;
  }
  .hp-services-wrapper { position: relative; }
  .hp-services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 52px;
  }
  @media (max-width: 860px) { .hp-services-grid { grid-template-columns: 1fr; } }

  /* ── Masterclass banner ── */
  .hp-masterclass-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 28px;
    padding: 26px 36px;
    border-radius: 20px;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, rgba(249,115,22,0.07) 0%, rgba(168,85,247,0.09) 100%);
    border: 1.5px solid transparent;
    background-clip: padding-box;
    outline: 1.5px solid rgba(168,85,247,0.25);
    transition: all 0.25s ease;
  }
  .hp-masterclass-banner::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(249,115,22,0.04), rgba(168,85,247,0.04));
    transition: opacity 0.25s ease;
  }
  .hp-masterclass-banner:hover {
    outline-color: rgba(168,85,247,0.5);
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(168,85,247,0.12);
  }
  .hp-mc-pulse {
    position: absolute;
    top: -60px; right: -60px;
    width: 200px; height: 200px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(168,85,247,0.15) 0%, transparent 70%);
    pointer-events: none;
  }
  .hp-mc-left {
    display: flex;
    flex-direction: column;
    gap: 5px;
    position: relative;
    z-index: 1;
    flex: 1;
  }
  .hp-mc-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #a855f7;
  }
  .hp-mc-text {
    font-size: 1.18rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.02em;
    background: linear-gradient(to right, #f97316, #a855f7);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hp-mc-sub {
    font-size: 0.87rem;
    color: #64748b;
    line-height: 1.5;
    max-width: 520px;
  }
  :global(.dark) .hp-mc-sub { color: #94a3b8; }
  .hp-mc-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 28px;
    border-radius: 12px;
    font-size: 0.92rem;
    font-weight: 700;
    white-space: nowrap;
    background: linear-gradient(135deg, #f97316, #a855f7);
    color: #fff;
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    box-shadow: 0 4px 20px rgba(168,85,247,0.25);
    transition: box-shadow 0.2s ease;
  }
  .hp-masterclass-banner:hover .hp-mc-cta { box-shadow: 0 6px 28px rgba(168,85,247,0.35); }
  .hp-mc-arrow { transition: transform 0.2s ease; }
  .hp-masterclass-banner:hover .hp-mc-arrow { transform: translateX(3px); }
  @media (max-width: 680px) {
    .hp-masterclass-banner { flex-direction: column; align-items: flex-start; padding: 22px 24px; gap: 16px; }
    .hp-mc-cta { width: 100%; justify-content: center; }
  }
  .hp-svc-card {
    position: relative;
    border-radius: var(--hp-radius);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: all var(--hp-t) var(--hp-ease);
    border: 1px solid var(--hp-border);
    box-shadow: 0 2px 20px rgba(0,0,0,0.06);
  }
  :global(.dark) .hp-svc-card { box-shadow: none; }
  .hp-svc-card-header {
    padding: 28px 28px 22px;
    position: relative;
  }
  .hp-svc-1 .hp-svc-card-header { background: linear-gradient(135deg, rgba(249,115,22,0.13) 0%, rgba(249,115,22,0.03) 100%); }
  .hp-svc-2 .hp-svc-card-header { background: linear-gradient(135deg, rgba(168,85,247,0.15) 0%, rgba(168,85,247,0.03) 100%); }
  .hp-svc-3 .hp-svc-card-header { background: linear-gradient(135deg, rgba(34,211,238,0.13) 0%, rgba(34,211,238,0.03) 100%); }
  .hp-svc-card-body {
    padding: 20px 28px 28px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: var(--hp-card);
  }
  :global(.dark) .hp-svc-card-body { background: rgba(255,255,255,0.03); }
  .hp-svc-card:hover { transform: translateY(-6px); }
  .hp-svc-1:hover { border-color: rgba(249,115,22,0.4); box-shadow: 0 20px 56px rgba(249,115,22,0.14); }
  .hp-svc-2:hover { border-color: rgba(168,85,247,0.4); box-shadow: 0 20px 56px rgba(168,85,247,0.14); }
  .hp-svc-3:hover { border-color: rgba(34,211,238,0.4);  box-shadow: 0 20px 56px rgba(34,211,238,0.12); }
  .hp-svc-icon {
    width: 48px; height: 48px;
    border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.5rem;
    margin-bottom: 14px;
  }
  .hp-svc-1 .hp-svc-icon { background: rgba(249,115,22,0.15); }
  .hp-svc-2 .hp-svc-icon { background: rgba(168,85,247,0.15); }
  .hp-svc-3 .hp-svc-icon { background: rgba(34,211,238,0.14); }
  .hp-svc-num {
    position: absolute; top: 16px; right: 20px;
    font-size: 3rem; font-weight: 900;
    letter-spacing: -0.05em; line-height: 1;
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    user-select: none;
  }
  .hp-svc-1 .hp-svc-num { background: linear-gradient(135deg, rgba(249,115,22,0.3), rgba(249,115,22,0.07)); }
  .hp-svc-2 .hp-svc-num { background: linear-gradient(135deg, rgba(168,85,247,0.35), rgba(168,85,247,0.07)); }
  .hp-svc-3 .hp-svc-num { background: linear-gradient(135deg, rgba(34,211,238,0.32), rgba(34,211,238,0.06)); }
  .hp-svc-badge {
    display: inline-block;
    font-size: 0.7rem; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase;
    padding: 4px 12px;
    border-radius: var(--hp-radius-pill);
    width: fit-content;
    margin-bottom: 10px;
  }
  .hp-svc-1 .hp-svc-badge { background: rgba(249,115,22,0.12); color: #f97316; border: 1px solid rgba(249,115,22,0.25); }
  .hp-svc-2 .hp-svc-badge { background: rgba(168,85,247,0.12); color: #a855f7; border: 1px solid rgba(168,85,247,0.25); }
  .hp-svc-3 .hp-svc-badge { background: rgba(34,211,238,0.12);  color: #22d3ee; border: 1px solid rgba(34,211,238,0.25); }
  .hp-svc-title { font-size: 1.2rem; font-weight: 700; letter-spacing: -0.025em; color: var(--hp-text); line-height: 1.3; }
  .hp-svc-desc { font-size: 0.92rem; color: var(--hp-muted); line-height: 1.65; }
  .hp-svc-bullets { list-style: none; display: flex; flex-direction: column; gap: 9px; flex: 1; padding: 0; margin: 0; }
  .hp-svc-bullets li {
    display: flex; align-items: flex-start; gap: 10px;
    font-size: 0.86rem; color: var(--hp-muted); line-height: 1.5;
  }
  .hp-svc-bullets li::before {
    content: ''; flex-shrink: 0;
    width: 5px; height: 5px; border-radius: 50%; margin-top: 7px;
  }
  .hp-svc-1 .hp-svc-bullets li::before { background: #f97316; }
  .hp-svc-2 .hp-svc-bullets li::before { background: #a855f7; }
  .hp-svc-3 .hp-svc-bullets li::before { background: #22d3ee; }
  .hp-svc-cta {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 0.86rem; font-weight: 600;
