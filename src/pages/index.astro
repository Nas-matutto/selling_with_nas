<script>
  let _hpRevealObserver: IntersectionObserver | null = null;

  function initHomepage() {
    // ── Scroll reveal ──
    if (_hpRevealObserver) {
      _hpRevealObserver.disconnect();
    }
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => { if (entry.isIntersecting) entry.target.classList.add('visible'); });
    }, { threshold: 0.08 });
    _hpRevealObserver = revealObserver;
    document.querySelectorAll('.hp-reveal').forEach(el => revealObserver.observe(el));

    // ── Bento card mouse spotlight ──
    document.querySelectorAll('.hp-bento-card').forEach(card => {
      card.addEventListener('mousemove', (e) => {
        const me = e as MouseEvent;
        const rect = (card as HTMLElement).getBoundingClientRect();
        (card as HTMLElement).style.setProperty('--mouse-x', ((me.clientX - rect.left) / rect.width * 100) + '%');
        (card as HTMLElement).style.setProperty('--mouse-y', ((me.clientY - rect.top) / rect.height * 100) + '%');
      });
    });

    // ── Posts carousel ──
    const track = document.getElementById('hpPostsTrack') as HTMLElement;
    const dotsEl = document.getElementById('hpPostsDots') as HTMLElement;
    const prevBtn = document.getElementById('hpArrowPrev') as HTMLButtonElement;
    const nextBtn = document.getElementById('hpArrowNext') as HTMLButtonElement;
    if (!track || !dotsEl || !prevBtn || !nextBtn) return;
    const cards = Array.from(track.children) as HTMLElement[];
    let idx = 0;

    function visibleCount() {
      const w = window.innerWidth;
      if (w <= 600) return 1;
      if (w <= 900) return 2;
      return 3;
    }
    function totalSlides() { return Math.max(1, cards.length - visibleCount() + 1); }

    function buildDots() {
      dotsEl.innerHTML = '';
      for (let i = 0; i < totalSlides(); i++) {
        const btn = document.createElement('button');
        btn.className = 'hp-posts-dot' + (i === 0 ? ' active' : '');
        btn.setAttribute('aria-label', 'Slide ' + (i + 1));
        btn.addEventListener('click', () => goTo(i));
        dotsEl.appendChild(btn);
      }
    }

    function goTo(n: number) {
      idx = Math.max(0, Math.min(n, totalSlides() - 1));
      const gap = 20;
      const cardW = cards[0].offsetWidth + gap;
      track.style.transform = 'translateX(-' + (idx * cardW) + 'px)';
      dotsEl.querySelectorAll('.hp-posts-dot').forEach((d, i) => d.classList.toggle('active', i === idx));
      prevBtn.disabled = idx === 0;
      nextBtn.disabled = idx >= totalSlides() - 1;
    }

    prevBtn.addEventListener('click', () => goTo(idx - 1));
    nextBtn.addEventListener('click', () => goTo(idx + 1));

    let sx = 0;
    track.addEventListener('touchstart', e => { sx = (e as TouchEvent).touches[0].clientX; }, { passive: true });
    track.addEventListener('touchend', e => {
      const dx = (e as TouchEvent).changedTouches[0].clientX - sx;
      if (Math.abs(dx) > 50) goTo(dx < 0 ? idx + 1 : idx - 1);
    });

    function initCarousel() { idx = 0; buildDots(); goTo(0); }
    initCarousel();
    window.addEventListener('resize', initCarousel);
  }

  initHomepage();
  document.addEventListener('astro:after-swap', initHomepage);
</script>
