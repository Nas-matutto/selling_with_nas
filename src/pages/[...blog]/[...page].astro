---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import Pagination from '~/components/blog/Pagination.astro';

import { blogListRobots, getStaticPathsBlogList, fetchPosts } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';
import { findImage } from '~/utils/images';
import { getFormattedDate } from '~/utils/utils';
import { APP_BLOG } from 'astrowind:config';
import type { ImageMetadata } from 'astro';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

const { page } = Astro.props as InferGetStaticPropsType<typeof getStaticPaths>;
const siteUrl = 'https://www.sellingwithnas.com';
const currentPage = page.currentPage ?? 1;

// Fetch all posts to extract all unique tags for the filter bar
const allPosts = await fetchPosts();
const tagMap = new Map<string, string>();
for (const post of allPosts) {
  if (post.tags && Array.isArray(post.tags)) {
    for (const tag of post.tags) {
      tagMap.set(tag.slug, tag.title);
    }
  }
}
const allTags = Array.from(tagMap.entries()).map(([slug, title]) => ({ slug, title }));

// Pre-resolve images for all posts on this page
const postsWithImages = await Promise.all(
  page.data.map(async (post) => {
    const image = (await findImage(post.image)) as ImageMetadata | undefined;
    const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
    const tagSlugs = post.tags?.map((t) => t.slug).join(' ') ?? '';
    return { post, image, link, tagSlugs };
  })
);

const metadata = {
  title: `${currentPage > 1 ? `Posts - Page ${currentPage}` : 'Posts'} | Selling with Nas`,
  description: 'Discover expert insights on e-commerce, sales strategies, GTM tactics, and business automations. Learn how to scale your online business with proven strategies.',
  canonical: `${siteUrl}/blog${currentPage > 1 ? `/page/${currentPage}` : ''}`,
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
};
---

<Layout metadata={metadata}>
  <section class="blog-listing-section">
    <div class="blog-listing-container">

      <!-- Header -->
      <div class="blog-listing-header">
        <span class="blog-listing-label">From the blog</span>
        <h1 class="blog-listing-title">All Posts</h1>
        <p class="blog-listing-sub">Insights on AI, e-commerce, sales and growth — filter by topic below.</p>
      </div>

      <!-- Tag Filter Bar -->
      <div class="tag-filter-bar" id="tagFilterBar">
        <button class="tag-pill active" data-tag="all">All</button>
        {allTags.map((tag) => (
          <button class="tag-pill" data-tag={tag.slug}>{tag.title}</button>
        ))}
      </div>

      <!-- Post Count -->
      <p class="post-count" id="postCount">{page.data.length} posts</p>

      <!-- Posts Grid -->
      <div class="posts-grid" id="postsGrid">
        {postsWithImages.map(({ post, image, link, tagSlugs }) => (
          <article class="post-card" data-tags={tagSlugs}>
            {image && link && (
              <a href={link} class="post-card-image-wrap" tabindex="-1" aria-hidden="true">
                <img
                  src={(image as any).src ?? image}
                  alt={post.title}
                  class="post-card-image"
                  loading="lazy"
                  decoding="async"
                  width="600"
                  height="338"
                />
              </a>
            )}
            <div class="post-card-body">
              <div class="post-card-meta">
                {post.category && (
                  <a href={getPermalink(post.category.slug, 'category')} class="post-card-category">
                    {post.category.title}
                  </a>
                )}
                <span class="post-card-date">{getFormattedDate(post.publishDate)}</span>
              </div>
              <h2 class="post-card-title">
                {link ? <a href={link}>{post.title}</a> : post.title}
              </h2>
              {post.excerpt && <p class="post-card-excerpt">{post.excerpt}</p>}
              {post.tags && post.tags.length > 0 && (
                <div class="post-card-tags">
                  {post.tags.map((tag) => (
                    <button class="post-tag-pill" data-filter-tag={tag.slug}>{tag.title}</button>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>

      <!-- No results message -->
      <p class="no-results" id="noResults" style="display:none;">No posts found for this tag.</p>

      <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
    </div>
  </section>
</Layout>

<script>
  const filterBar = document.getElementById('tagFilterBar');
  const grid = document.getElementById('postsGrid');
  const postCount = document.getElementById('postCount');
  const noResults = document.getElementById('noResults');

  function filterPosts(tag: string) {
    if (!grid) return;
    const cards = grid.querySelectorAll<HTMLElement>('.post-card');
    let visible = 0;

    cards.forEach((card) => {
      const tags = card.dataset.tags ?? '';
      const show = tag === 'all' || tags.split(' ').includes(tag);
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    if (postCount) postCount.textContent = `${visible} post${visible !== 1 ? 's' : ''}`;
    if (noResults) noResults.style.display = visible === 0 ? 'block' : 'none';
  }

  // Filter bar buttons
  filterBar?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.tag-pill');
    if (!btn) return;
    filterBar.querySelectorAll('.tag-pill').forEach((b) => b.classList.remove('active'));
    btn.classList.add('active');
    filterPosts(btn.dataset.tag ?? 'all');
  });

  // Tag pills on cards (clicking a tag on a card activates that filter)
  grid?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.post-tag-pill');
    if (!btn) return;
    const tag = btn.dataset.filterTag ?? 'all';
    filterBar?.querySelectorAll('.tag-pill').forEach((b) => {
      b.classList.toggle('active', (b as HTMLButtonElement).dataset.tag === tag);
    });
    filterPosts(tag);
    filterBar?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });
</script>

<style>
  .blog-listing-section {
    background: radial-gradient(ellipse at 50% -10%, rgba(249,115,22,0.06) 0%, transparent 60%);
    min-height: 100vh;
    padding: 60px 20px 80px;
  }
  :global(.dark) .blog-listing-section {
    background: radial-gradient(ellipse at 50% -10%, rgba(249,115,22,0.04) 0%, transparent 60%);
  }

  .blog-listing-container {
    max-width: 1280px;
    margin: 0 auto;
  }

  /* Header */
  .blog-listing-header {
    text-align: center;
    margin-bottom: 40px;
    animation: fadeSlideUp 0.5s cubic-bezier(0.4, 0, 0.2, 1) both;
  }

  .blog-listing-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #f97316;
    margin-bottom: 12px;
  }
  .blog-listing-label::before,
  .blog-listing-label::after {
    content: '';
    display: block;
    width: 20px;
    height: 2px;
    background: linear-gradient(90deg, #f97316, #f59e0b);
    border-radius: 2px;
  }

  .blog-listing-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, #f97316 0%, #ef4444 50%, #a855f7 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 10px;
  }

  .blog-listing-sub {
    font-size: 1rem;
    color: #64748b;
    max-width: 480px;
    margin: 0 auto;
  }
  :global(.dark) .blog-listing-sub { color: #94a3b8; }

  /* Tag Filter Bar */
  .tag-filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin-bottom: 16px;
    padding: 0 4px;
  }

  .tag-pill {
    display: inline-block;
    padding: 6px 16px;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    border: 1.5px solid rgba(249,115,22,0.3);
    background: transparent;
    color: #64748b;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .tag-pill:hover {
    border-color: #f97316;
    color: #f97316;
    background: rgba(249,115,22,0.06);
  }
  .tag-pill.active {
    background: linear-gradient(135deg, #f97316, #ef4444);
    border-color: transparent;
    color: white;
    box-shadow: 0 4px 12px rgba(249,115,22,0.3);
  }
  :global(.dark) .tag-pill {
    color: #94a3b8;
    border-color: rgba(255,255,255,0.15);
  }
  :global(.dark) .tag-pill:hover {
    color: #fb923c;
    border-color: #fb923c;
    background: rgba(249,115,22,0.08);
  }
  :global(.dark) .tag-pill.active {
    color: white;
    border-color: transparent;
  }

  /* Post Count */
  .post-count {
    text-align: center;
    font-size: 0.82rem;
    color: #94a3b8;
    margin-bottom: 28px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  /* Posts Grid */
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  @media (max-width: 1100px) {
    .posts-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 720px) {
    .posts-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .posts-grid { grid-template-columns: 1fr; }
  }

  /* Post Card */
  .post-card {
    background: white;
    border-radius: 14px;
    border: 1px solid rgba(0,0,0,0.07);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }
  .post-card::before {
    content: '';
    display: block;
    height: 3px;
    background: linear-gradient(90deg, #f97316, #ef4444, #a855f7);
    flex-shrink: 0;
  }
  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 32px rgba(0,0,0,0.09);
    border-color: rgba(249,115,22,0.2);
  }
  :global(.dark) .post-card {
    background: rgba(255,255,255,0.04);
    border-color: rgba(255,255,255,0.07);
  }
  :global(.dark) .post-card:hover {
    box-shadow: 0 14px 32px rgba(0,0,0,0.3);
    border-color: rgba(249,115,22,0.25);
  }

  /* Card Image */
  .post-card-image-wrap {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    flex-shrink: 0;
  }
  .post-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  .post-card:hover .post-card-image {
    transform: scale(1.03);
  }

  /* Card Body */
  .post-card-body {
    padding: 16px 18px 18px;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 8px;
  }

  .post-card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .post-card-category {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #f97316;
    text-decoration: none;
    background: rgba(249,115,22,0.08);
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid rgba(249,115,22,0.2);
  }
  .post-card-category:hover { background: rgba(249,115,22,0.15); }

  .post-card-date {
    font-size: 0.75rem;
    color: #94a3b8;
  }

  .post-card-title {
    font-size: 0.97rem;
    font-weight: 700;
    line-height: 1.4;
    color: #0f172a;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  :global(.dark) .post-card-title { color: #e2e8f0; }
  .post-card-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .post-card-title a:hover { color: #f97316; }

  .post-card-excerpt {
    font-size: 0.85rem;
    color: #64748b;
    line-height: 1.55;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }
  :global(.dark) .post-card-excerpt { color: #94a3b8; }

  /* Tag pills on cards */
  .post-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: auto;
    padding-top: 4px;
  }

  .post-tag-pill {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 999px;
    border: 1px solid rgba(0,0,0,0.1);
    background: #f1f5f9;
    color: #475569;
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
  }
  .post-tag-pill:hover {
    background: rgba(249,115,22,0.1);
    border-color: rgba(249,115,22,0.3);
    color: #f97316;
  }
  :global(.dark) .post-tag-pill {
    background: rgba(255,255,255,0.06);
    border-color: rgba(255,255,255,0.1);
    color: #94a3b8;
  }
  :global(.dark) .post-tag-pill:hover {
    background: rgba(249,115,22,0.12);
    border-color: rgba(249,115,22,0.3);
    color: #fb923c;
  }

  /* No results */
  .no-results {
    text-align: center;
    color: #94a3b8;
    font-size: 1rem;
    padding: 40px 0;
  }

  @keyframes fadeSlideUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>
