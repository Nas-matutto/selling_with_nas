---
export const prerender = true;

// Free interactive crash course, and the landing spot for Nas's educational
// social content. Finishing ANY one game unlocks $20 off the Build-It Pack -
// but that is a surprise: the page only hints at it ("unlock a surprise") and
// RewardCard reveals the discount after the first finished game.
//
// Split into components rather than the one-big-file pattern the other pages
// use: four interactive modules each need their own DOM contract and feedback
// styling, and Astro's scoped styles do that namespacing for free. Shared
// primitives live in ~/components/learn/learn.css because scoped styles do NOT
// cross component boundaries. Please don't "fix" this back into a single file.
import Layout from '~/layouts/PageLayout.astro';
import '~/components/learn/learn.css';

import ProgressRail from '~/components/learn/ProgressRail.astro';
import JargonDecoder from '~/components/learn/JargonDecoder.astro';
import PromptLab from '~/components/learn/PromptLab.astro';
import SpotTheMistake from '~/components/learn/SpotTheMistake.astro';
import LiteracyQuiz from '~/components/learn/LiteracyQuiz.astro';

import { faqs } from '~/data/learn-ai-101';

const metadata = {
  title: 'Learn AI 101 — A Free, Hands-On Crash Course in How AI Actually Works',
  description:
    'Four interactive modules: what an LLM really does, how to prompt it properly, where it lies to you, and an 8-question literacy check. Free, no signup, about 20 minutes.',
  keywords:
    'learn AI, AI for beginners, AI basics explained, what is an LLM, how to prompt AI, AI literacy quiz, prompt engineering basics, free AI course, AI fundamentals',
  canonical: 'https://www.sellingwithnas.com/learn-ai-101',
};

const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'Learn AI 101',
  description:
    'A free, hands-on crash course in how AI actually works: the vocabulary, prompting, spotting AI mistakes, and an 8-question literacy check.',
  provider: { '@type': 'Organization', name: 'Selling with Nas', url: 'https://www.sellingwithnas.com' },
  isAccessibleForFree: true,
  inLanguage: 'en',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', category: 'Free' },
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'online',
    courseWorkload: 'PT20M',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout metadata={metadata} metaPixelId="1700269051050500">
  <script type="application/ld+json" set:html={JSON.stringify(courseSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="l101">
    <div class="l101-ambient" aria-hidden="true">
      <div class="l101-blob l101-blob-1"></div>
      <div class="l101-blob l101-blob-2"></div>
      <div class="l101-blob l101-blob-3"></div>
    </div>

    <!-- ════ HERO ════ -->
    <section class="lp-hero" id="top">
      <div class="l101-container">
        <h1 class="lp-h1">Learn AI with <span class="l101-gradient">mini games</span></h1>

        <!-- Shown only when there's something to resume. -->
        <div class="lp-resume" data-lp-resume hidden>
          <p>Welcome back — your progress is saved.</p>
          <button type="button" class="lp-reset" data-lp-reset>Start over</button>
        </div>

        <ProgressRail />
      </div>
    </section>

    <!-- ════ GAME 1 ════ -->
    <JargonDecoder />

    <!-- ════ GAME 2 ════ -->
    <PromptLab />

    <!-- ════ GAME 3 ════ -->
    <SpotTheMistake />

    <!-- ════ GAME 4 ════ -->
    <LiteracyQuiz />

    <!-- ════ FAQ ════ -->
    <section class="l101-section l101-section-alt">
      <div class="l101-container">
        <div class="l101-head">
          <h2 class="l101-title">Questions</h2>
        </div>

        <div class="lp-faqs">
          {
            faqs.map((f) => (
              <details class="lp-faq l101-card">
                <summary class="lp-faq-q">{f.q}</summary>
                <p class="lp-faq-a">{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <div class="lp-back-row">
      <a href="/" class="l101-btn-ghost">← Back to Home</a>
    </div>
  </div>
</Layout>

<script>
  // ── Page controller ──
  // Owns the resume banner and every analytics call. Modules
  // only ever emit events upward; nothing is broadcast down to them, because
  // script execution order across hoisted bundles is not guaranteed.
  import { loadState, doneCount, resetState, MODULE_IDS } from '~/data/learn-ai-101';

  type Gtag = (...args: unknown[]) => void;
  type Fbq = (...args: unknown[]) => void;
  const gtag = () => (window as unknown as { gtag?: Gtag }).gtag;
  const fbq = () => (window as unknown as { fbq?: Fbq }).fbq;

  function track(event: string, params?: Record<string, unknown>) {
    gtag()?.('event', event, params ?? {});
  }

  function initController() {
    const root = document.querySelector<HTMLElement>('.l101');
    if (!root || root.dataset.l101Controller === '1') return;
    root.dataset.l101Controller = '1';

    const resume = document.querySelector<HTMLElement>('[data-lp-resume]');

    function syncChrome() {
      const state = loadState();

      // Offer "Start over" whenever anything is saved - including a game that
      // is only partly answered, so a stale answer can always be cleared.
      const started = MODULE_IDS.some((m) => Object.keys(state.modules[m].answers).length > 0);
      if (resume) resume.hidden = !started;
    }

    // ── analytics ──
    let startedSent = false;
    document.addEventListener('l101:started', () => {
      if (startedSent) return;
      startedSent = true;
      track('ai101_start');
      fbq()?.('trackCustom', 'AI101Start');
    });

    // Guard per module so a resume can never double-count a completion.
    const counted = new Set<string>();
    document.addEventListener('l101:progress', (e) => {
      const d = (e as CustomEvent).detail as { module: string; done: boolean; score: number; total: number };
      if (d?.done && !counted.has(d.module)) {
        counted.add(d.module);
        track('ai101_module_complete', { module_id: d.module, score: d.score, total: d.total });
      }
      syncChrome();
    });

    document.addEventListener('l101:unlock', (e) => {
      const d = (e as CustomEvent).detail as { module: string };
      track('ai101_reward_unlocked', { module_id: d?.module });
      // The retargeting audience for the pack.
      fbq()?.('trackCustom', 'AI101Unlock');
      syncChrome();
    });

    document.addEventListener('l101:quiz-submitted', (e) => {
      const d = (e as CustomEvent).detail as { score: number; total: number; tier: string };
      track('ai101_quiz_complete', { value: d?.score, total: d?.total, tier: d?.tier });
      fbq()?.('trackCustom', 'AI101Complete', { score: d?.score, tier: d?.tier });
    });

    document.addEventListener('click', (e) => {
      const cta = (e.target as HTMLElement | null)?.closest<HTMLElement>('a[data-cta]');
      if (!cta) return;
      const name = cta.getAttribute('data-cta') ?? '';
      track('ai101_cta_click', { cta: name });
      // Only the checkout-bound CTAs are checkout intent.
      if (cta.getAttribute('href')?.includes('buy.stripe.com')) {
        fbq()?.('track', 'InitiateCheckout', { value: 77, currency: 'USD', source_section: name });
      }
    });

    // ── start over ──
    document.querySelector<HTMLButtonElement>('[data-lp-reset]')?.addEventListener('click', () => {
      resetState();
      window.location.reload();
    });

    syncChrome();

    // Report a resumed session once, after the chrome is in sync.
    const done = doneCount(loadState());
    if (done > 0) track('ai101_resume', { modules_done: done });
  }

  initController();
  document.addEventListener('astro:page-load', initController);
  document.addEventListener('astro:after-swap', initController);
</script>

<style>
  /* ════ HERO ════ */
  .lp-hero {
    position: relative;
    z-index: 1;
    padding: 56px 0 8px;
    text-align: center;
  }
  .lp-h1 {
    font-size: clamp(2.1rem, 6vw, 3.6rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.04em;
    margin: 0 0 28px;
    color: var(--l101-text);
  }

  /* ════ RESUME ════ */
  .lp-resume {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    max-width: 760px;
    margin: 0 auto 16px;
    padding: 12px 18px;
    background: var(--l101-ok-bg);
    border: 1px solid var(--l101-ok-border);
    border-radius: 12px;
  }
  /* `display: flex` above would otherwise beat the UA's [hidden] rule. */
  .lp-resume[hidden] {
    display: none;
  }
  .lp-resume p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--l101-ok-fg);
  }
  .lp-reset {
    font-family: inherit;
    font-size: 0.78rem;
    font-weight: 600;
    background: none;
    border: none;
    color: var(--l101-muted);
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
  }
  .lp-reset:hover {
    color: var(--l101-text);
  }

  /* ════ FAQ ════ */
  .lp-faqs {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 780px;
    margin: 0 auto;
  }
  .lp-faq {
    padding: 0;
  }
  .lp-faq-q {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 17px 20px;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--l101-text);
    cursor: pointer;
    list-style: none;
  }
  .lp-faq-q::-webkit-details-marker {
    display: none;
  }
  .lp-faq-q::after {
    content: '＋';
    margin-left: auto;
    color: var(--l101-purple);
    font-weight: 700;
    flex-shrink: 0;
  }
  .lp-faq[open] .lp-faq-q::after {
    content: '−';
  }
  .lp-faq-a {
    margin: 0;
    padding: 0 20px 18px;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--l101-muted);
  }

  .lp-back-row {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 0 0 56px;
  }

  @media (max-width: 640px) {
    .lp-hero {
      padding-top: 40px;
    }
  }
</style>
