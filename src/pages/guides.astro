---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Free AI Guides — Selling with Nas',
  description: 'Download free PDF guides on AI agents, Claude, prompt engineering, and AI automation for business. Drop your email and the guide lands in your inbox instantly.',
  keywords: 'free AI guide, Claude guide PDF, AI agent guide, prompt engineering guide, AI automation for business, free AI resources, Nas AI guides',
  canonical: 'https://www.sellingwithnas.com/guides',
};

const guides = [
  {
    id: 'best-claude-skills',
    emoji: '⚡',
    tag: 'Claude',
    title: 'Best Claude Skills',
    description: 'A curated guide to the most powerful Claude Skills available right now — what they do, how to install them, and exactly how to use them to build websites, create AI videos, automate marketing, and ship faster than ever. This is the shortcut to getting real results with Claude from day one.',
    gradientClass: 'gg-orange',
    subject: 'Your Best Claude Skills Guide',
  },
];

---

<Layout metadata={metadata}>
<div class="guides-page">

  <div class="guides-ambient" aria-hidden="true">
    <div class="guides-blob gb-1"></div>
    <div class="guides-blob gb-2"></div>
  </div>

  <!-- ── HERO ── -->
  <section class="guides-hero">
    <div class="guides-container">
      <span class="guides-eyebrow">Free Resources</span>
      <h1 class="guides-title">
        Free AI Guides —<br />
        <span class="guides-gradient">delivered to your inbox</span>
      </h1>
      <p class="guides-sub">
        Practical PDF guides on Claude, AI agents, prompting, and automation.
        Drop your email on any guide below and I'll send it straight to you.
      </p>
    </div>
  </section>

  <!-- ── GUIDES GRID ── -->
  <section class="guides-section">
    <div class="guides-container">
      <div class="guides-grid">

        {guides.map((guide) => (
          <div class="guide-card" id={guide.id}>
            <div class={`guide-card-top ${guide.gradientClass}`}></div>
            <div class="guide-card-body">

              <div class="guide-meta-row">
                <span class="guide-emoji">{guide.emoji}</span>
                <span class="guide-tag">{guide.tag}</span>
              </div>

              <h2 class="guide-title">{guide.title}</h2>
              <p class="guide-desc">{guide.description}</p>

              <form
                class="guide-form"
                action="/api/send-guide"
                method="POST"
              >

                <div class="guide-form-row">
                  <input
                    type="email"
                    name="email"
                    placeholder="Your email address"
                    required
                    class="guide-input"
                    autocomplete="email"
                  />
                  <button type="submit" class={`guide-btn ${guide.gradientClass}`}>
                    Send me this guide →
                  </button>
                </div>
                <p class="guide-privacy">No spam. Unsubscribe any time.</p>
              </form>

            </div>
          </div>
        ))}

      </div>
    </div>
  </section>

  <!-- ── ERROR BANNER ── -->
  <div id="guides-error" class="guides-error" style="display:none;" aria-live="polite">
    <div class="guides-success-inner">
      <span class="guides-success-icon">⚠️</span>
      <div>
        <strong>Something went wrong — the email wasn't sent.</strong>
        <p>Please try again, or email me directly at <a href="mailto:nas@talktomedata.com">nas@talktomedata.com</a> and I'll send it to you manually.</p>
      </div>
    </div>
  </div>

  <!-- ── SUCCESS BANNER (shown via URL param) ── -->
  <div id="guides-success" class="guides-success" style="display:none;" aria-live="polite">
    <div class="guides-success-inner">
      <span class="guides-success-icon">✅</span>
      <div>
        <strong>Check your inbox — the guide is on its way!</strong>
        <p>Can't find it? Check your spam folder, or email me directly at <a href="mailto:nas@talktomedata.com">nas@talktomedata.com</a> and I'll send it over.</p>
      </div>
    </div>
  </div>

  <!-- ── CTA STRIP ── -->
  <section class="guides-cta-strip">
    <div class="guides-container guides-cta-inner">
      <div>
        <p class="guides-cta-label">Want to go deeper?</p>
        <p class="guides-cta-text">Join my live AI Masterclass and build real workflows in 90 minutes.</p>
      </div>
      <a href="/ai-masterclass-with-nas" class="guides-cta-btn">See the Masterclass →</a>
    </div>
  </section>

</div>

<script>
  const params = new URLSearchParams(window.location.search);
  if (params.has('sent')) {
    const banner = document.getElementById('guides-success');
    if (banner) { banner.style.display = 'block'; banner.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
    window.history.replaceState({}, '', '/guides');
  }
  if (params.has('error')) {
    const banner = document.getElementById('guides-error');
    if (banner) { banner.style.display = 'block'; banner.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
    window.history.replaceState({}, '', '/guides');
  }
</script>

<style>
  /* ════ BASE ════ */
  .guides-page {
    background: #ffffff;
    color: #0f172a;
    min-height: 100vh;
    overflow-x: hidden;
    position: relative;
  }
  :global(.dark) .guides-page { background: #05050f; color: #e2e8f0; }

  .guides-container { max-width: 1080px; margin: 0 auto; padding: 0 24px; }

  /* ════ AMBIENT ════ */
  .guides-ambient { position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
  .guides-blob {
    position: absolute; border-radius: 50%;
    filter: blur(130px); opacity: 0.06;
    animation: gbDrift 18s ease-in-out infinite alternate;
  }
  :global(.dark) .guides-blob { opacity: 0.14; }
  .gb-1 { width: 600px; height: 600px; background: #f97316; top: -100px; left: -100px; }
  .gb-2 { width: 500px; height: 500px; background: #a855f7; bottom: -100px; right: -100px; animation-delay: 8s; }
  @keyframes gbDrift {
    from { transform: translate(0,0) scale(1); }
    to   { transform: translate(30px, 20px) scale(1.06); }
  }
  .guides-hero, .guides-section, .guides-cta-strip { position: relative; z-index: 1; }

  /* ════ HERO ════ */
  .guides-hero { padding: 96px 0 56px; text-align: center; }
  .guides-eyebrow {
    display: inline-block;
    font-size: 0.73rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: #f97316; margin-bottom: 16px;
  }
  .guides-title {
    font-size: clamp(2rem, 5vw, 3.2rem); font-weight: 800;
    letter-spacing: -0.03em; line-height: 1.15;
    color: #0f172a; margin: 0 0 20px;
  }
  :global(.dark) .guides-title { color: #f8fafc; }
  .guides-gradient {
    background: linear-gradient(to right, #f97316, #a855f7);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .guides-sub {
    font-size: 1.05rem; color: #475569; max-width: 540px; margin: 0 auto; line-height: 1.7;
  }
  :global(.dark) .guides-sub { color: #94a3b8; }

  /* ════ GRID — single centred card ════ */
  .guides-section { padding: 16px 0 96px; }
  .guides-grid {
    display: flex;
    justify-content: center;
  }

  /* ════ GUIDE CARD — large single ════ */
  .guide-card {
    width: 100%;
    max-width: 720px;
    border-radius: 24px;
    border: 1px solid #e2e8f0;
    background: #ffffff;
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(0,0,0,0.07);
    display: flex;
    flex-direction: column;
  }
  :global(.dark) .guide-card { background: rgba(255,255,255,0.04); border-color: rgba(255,255,255,0.09); box-shadow: none; }

  .guide-card-top { height: 6px; }
  .gg-orange { background: linear-gradient(90deg, #f97316, #ef4444); }
  .gg-purple { background: linear-gradient(90deg, #a855f7, #6366f1); }
  .gg-cyan   { background: linear-gradient(90deg, #22d3ee, #3b82f6); }
  .gg-amber  { background: linear-gradient(90deg, #f59e0b, #f97316); }

  .guide-card-body { padding: 44px 48px 40px; display: flex; flex-direction: column; gap: 20px; flex: 1; }

  .guide-meta-row { display: flex; align-items: center; gap: 12px; }
  .guide-emoji { font-size: 2.4rem; line-height: 1; }
  .guide-tag {
    font-size: 0.73rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    color: #64748b; background: #f1f5f9; padding: 5px 14px; border-radius: 999px;
  }
  :global(.dark) .guide-tag { background: rgba(255,255,255,0.07); color: #94a3b8; }

  .guide-title {
    font-size: 2rem; font-weight: 800; color: #0f172a;
    margin: 0; letter-spacing: -0.03em; line-height: 1.2;
  }
  :global(.dark) .guide-title { color: #f1f5f9; }
  .guide-desc { font-size: 1rem; color: #475569; line-height: 1.75; margin: 0; }
  :global(.dark) .guide-desc { color: #94a3b8; }

  /* ════ FORM ════ */
  .guide-form { display: flex; flex-direction: column; gap: 10px; margin-top: 8px; }
  .guide-form-row { display: flex; gap: 10px; }
  .guide-input {
    flex: 1; min-width: 0;
    padding: 14px 18px;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    background: #f8fafc;
    font-size: 0.97rem;
    color: #0f172a;
    outline: none;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }
  :global(.dark) .guide-input { background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.1); color: #f1f5f9; }
  .guide-input::placeholder { color: #94a3b8; }
  .guide-input:focus { border-color: #f97316; box-shadow: 0 0 0 3px rgba(249,115,22,0.1); }
  .guide-btn {
    padding: 14px 28px;
    border-radius: 12px;
    border: none;
    cursor: pointer;
    font-size: 0.97rem;
    font-weight: 700;
    color: #fff;
    white-space: nowrap;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
    flex-shrink: 0;
  }
  .guide-btn:hover { transform: translateY(-2px); }
  .guide-btn.gg-orange { background: linear-gradient(135deg, #f97316, #ef4444); box-shadow: 0 4px 20px rgba(249,115,22,0.3); }
  .guide-privacy { font-size: 0.78rem; color: #94a3b8; margin: 0; }

  /* ════ SUCCESS BANNER ════ */
  .guides-success {
    max-width: 720px;
    margin: 0 auto 32px;
    padding: 20px 24px;
    border-radius: 14px;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    color: #15803d;
  }
  :global(.dark) .guides-success { background: rgba(34,197,94,0.08); border-color: rgba(34,197,94,0.2); color: #86efac; }
  .guides-success-inner { display: flex; gap: 14px; align-items: flex-start; }
  .guides-success-icon { font-size: 1.4rem; flex-shrink: 0; }
  .guides-success strong { display: block; font-size: 0.97rem; margin-bottom: 4px; }
  .guides-success p { font-size: 0.88rem; margin: 0; opacity: 0.9; }
  .guides-success a { color: inherit; font-weight: 600; }

  /* ════ ERROR BANNER ════ */
  .guides-error {
    max-width: 720px;
    margin: 0 auto 32px;
    padding: 20px 24px;
    border-radius: 14px;
    background: #fffbeb;
    border: 1px solid #fde68a;
    color: #92400e;
  }
  :global(.dark) .guides-error { background: rgba(245,158,11,0.08); border-color: rgba(245,158,11,0.2); color: #fcd34d; }
  .guides-error strong { display: block; font-size: 0.97rem; margin-bottom: 4px; }
  .guides-error p { font-size: 0.88rem; margin: 0; opacity: 0.9; }
  .guides-error a { color: inherit; font-weight: 600; }

  /* ════ CTA STRIP ════ */
  .guides-cta-strip {
    background: #f8fafc;
    border-top: 1px solid #e2e8f0;
    padding: 40px 0;
  }
  :global(.dark) .guides-cta-strip { background: rgba(255,255,255,0.025); border-color: rgba(255,255,255,0.06); }
  .guides-cta-inner {
    display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap;
  }
  .guides-cta-label { font-size: 0.73rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #a855f7; margin: 0 0 6px; }
  .guides-cta-text { font-size: 1rem; font-weight: 600; color: #0f172a; margin: 0; }
  :global(.dark) .guides-cta-text { color: #f1f5f9; }
  .guides-cta-btn {
    display: inline-block; padding: 13px 28px; border-radius: 12px;
    background: linear-gradient(135deg, #f97316, #a855f7);
    color: #fff; font-weight: 700; font-size: 0.95rem; text-decoration: none;
    box-shadow: 0 4px 20px rgba(168,85,247,0.25);
    transition: transform 0.2s ease, box-shadow 0.2s ease; white-space: nowrap;
  }
  .guides-cta-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(168,85,247,0.35); }

  /* ════ RESPONSIVE ════ */
  @media (max-width: 600px) {
    .guides-hero { padding: 72px 0 40px; }
    .guide-card-body { padding: 28px 24px 24px; }
    .guide-title { font-size: 1.4rem; }
    .guide-form-row { flex-direction: column; }
    .guide-btn { width: 100%; text-align: center; }
    .guides-cta-inner { flex-direction: column; align-items: flex-start; }
    .guides-cta-btn { width: 100%; text-align: center; }
  }
</style>
</Layout>
